+    truncated = true;
+    return;
+  }
+  const node = { key, st, trail };
+  seen.set(key, node);
+  queue.push(node);
+}
+
+enqueue(E.initState(D), []);
+for (let cursor = 0; cursor < queue.length; cursor++) {
