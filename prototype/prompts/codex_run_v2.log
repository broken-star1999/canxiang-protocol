+        i++;
+        return { type: "literal", value: t === "true" };
+      }
+      if (/^(?:\d+(?:\.\d*)?|\.\d+)$/.test(t)) {
+        i++;
+        return { type: "literal", value: Number(t) };
+      }
+      if (/^[A-Za-z_][A-Za-z0-9_.-]*$/.test(t)) {
+        i++;
+        return { type: "name", name: t };
+      }
