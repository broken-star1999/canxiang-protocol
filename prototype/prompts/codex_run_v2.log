+    }
+  }
+
+  function checkBonuses(D, st) {
+    for (const bonus of D.bonuses || []) {
+      if (bonus.once !== false && st.bonuses.includes(bonus.id)) continue;
+      if (evalWhen(bonus.when, st)) {
