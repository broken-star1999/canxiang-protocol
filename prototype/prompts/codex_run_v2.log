+P(`\n[引擎自检] 表达式${okExpr ? "✓" : "✗"} requires${okRequires ? "✓" : "✗"} hide_if${okHide ? "✓" : "✗"} 三条件组合/字面 requires${okVisibility ? "✓" : "✗"} 键值 flag/in${keyValues ? "✓" : "✗"} all/any${objects ? "✓" : "✗"} min/max${okClamp ? "✓" : "✗"} parse-warn-once${!bad1 && !bad2 && warnings === 1 ? "✓" : "✗"} 无动态执行${noDynamicCode ? "✓" : "✗"} bonus-once${okBonus ? "✓" : "✗"} variant/占位/自我结局${okVariant ? "✓" : "✗"} 兜底same_as${okFallback ? "✓" : "✗"}`);
+if (!(okExpr && okRequires && okHide && okVisibility && keyValues && objects && okClamp && !bad1 && !bad2 && warnings === 1 && noDynamicCode && okBonus && okVariant && okFallback)) fail = 1;
+
+// Three true-ending route cases run once every referenced flag has a setter.
+const ROUTES = {
+  "甲 现场派": ["c1_s01a_mira", "c1_s01b_chat"],
+  "乙 日志派": ["c1_s00a_answer", "c1_s01a_mira"],
