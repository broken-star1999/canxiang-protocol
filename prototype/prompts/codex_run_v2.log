+        st.bonuses.push(bonus.id);
+        st.log.push({ text: "［联动］" + (bonus.log || bonus.id), at: st.mins, bonus: true });
+      }
+    }
+  }
+
+  function apply(st, choice, D) {
+    eff(st, choice.effects, D);
+    for (const flag of choice.flags_set || []) {
