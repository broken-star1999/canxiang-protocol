+function sortedObject(obj) {
+  return Object.fromEntries(Object.keys(obj || {}).sort().map(k => [k, obj[k]]));
+}
+function stateKey(st) {
+  return JSON.stringify([
+    st.scene,
+    [...(st.flags || [])].sort(),
+    sortedObject(st.vals),
+    [...(st.bonuses || [])].sort()
