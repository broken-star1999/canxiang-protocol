#!/usr/bin/env python3
"""合并 story/ 各段最高版本 + puzzle/*endings_v*.yaml 最高版本 + art/out 图片清单 -> data.json / data.js"""
import json, os, re, glob, yaml
HERE = os.path.dirname(os.path.abspath(__file__)); ROOT = os.path.dirname(HERE)
def latest(files, rx):
    best = {}
    for f in files:
        m = re.match(rx, os.path.basename(f))
        if not m: continue
        k, v = m.group(1), int(m.group(2))
        if k not in best or v > best[k][0]: best[k] = (v, f)
    return [best[k][1] for k in sorted(best)]
segs = latest(glob.glob(os.path.join(ROOT, "story", "*.yaml")), r"(.+?)_draft_v(\d+)\.ya?ml$")
D = {"values": {}, "clock_start": "00:00", "scenes": [], "endings": [], "bonuses": [], "self_endings": [], "_sources": []}
for f in segs:
    d = yaml.safe_load(open(f, encoding="utf-8")) or {}
    if not D["scenes"]:
        D["values"] = d.get("values", {}); D["clock_start"] = d.get("clock_start", "00:00")
    D["scenes"] += d.get("scenes") or []
    for k in ("endings", "bonuses", "self_endings"): D[k] += d.get(k) or []
    D["_sources"].append(os.path.relpath(f, ROOT))
for f in latest(glob.glob(os.path.join(ROOT, "puzzle", "*endings_v*.yaml")), r"(.*endings)_v(\d+)\.ya?ml$"):
    d = yaml.safe_load(open(f, encoding="utf-8")) or {}
    for k in ("endings", "bonuses", "self_endings"): D[k] += d.get(k) or []
    D["_sources"].append(os.path.relpath(f, ROOT))
# 图片：art/out/ 下取最高 vN；samples 作后备
imgs = {}
def add(key, pattern):
    vs = []
    for f in glob.glob(os.path.join(ROOT, "art", "out", "**", pattern), recursive=True):
        m = re.search(r"_v(\d+)\.webp$", f)
        if m: vs.append((int(m.group(1)), f))
    if vs: imgs[key] = os.path.relpath(max(vs)[1], HERE)
fallback = {"scene_bay7_poweroff": "../samples/scene_bay7_poweroff_v2.png", "mira_lv1": "../samples/portrait_mira_lv1_v1.png"}
for s in D["scenes"]:
    for k in filter(None, [s.get("bg"), s.get("portrait")]): add(k, f"{k}_v*.webp")
    for c in s.get("choices") or []: add("thumb:" + c["id"], f"thumb_{c['id']}_v*.webp")
for e in D["endings"]: add("ending:" + e["id"], f"ending_{e['id']}_v*.webp")
for k, v in fallback.items():
    if k not in imgs and os.path.exists(os.path.join(HERE, v)): imgs[k] = v
D["images"] = imgs
s = json.dumps(D, ensure_ascii=False, indent=1)
open(os.path.join(HERE, "data.json"), "w", encoding="utf-8").write(s)
open(os.path.join(HERE, "data.js"), "w", encoding="utf-8").write("window.STORY=" + s + ";")
print("sources:", *D["_sources"], f"| scenes={len(D['scenes'])} endings={len(D['endings'])} bonuses={len(D['bonuses'])} images={len(imgs)}")
<!doctype html><html lang="zh"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>残响协议 · 原型</title><link rel="stylesheet" href="style.css"></head><body>
<header id="hdr"><span id="clock">05:00</span><span id="sid"></span>
<nav><button data-p="log">日志</button><button data-p="stats">数值</button><button data-p="menu">菜单</button></nav></header>
<main id="stage"><div id="bg"></div><div id="portrait"></div>
<section id="text"></section><section id="choices"></section></main>
<aside id="log" class="panel hidden"><h3>行动日志</h3><ol id="logList"></ol></aside>
<aside id="stats" class="panel hidden"><h3>数值（调试）</h3><pre id="statPre"></pre></aside>
<aside id="menu" class="panel hidden"><h3>菜单</h3>
<button id="save">存档</button><button id="load">读档</button><button id="restart">重开</button>
<label><input type="checkbox" id="optKey"> 在选项上标出关键抉择</label><p id="msg"></p></aside>
<script src="data.js"></script><script src="engine.js"></script><script src="app.js"></script></body></html>
:root{--bg:#07110d;--fg:#cfe3d8;--dim:#6f8f80;--mira:#3ff0e6;--line:#1f3a2f;--key:#7fd8b0}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.75 system-ui,"PingFang SC","Noto Sans CJK SC",sans-serif;max-width:560px;margin:auto}
#hdr{position:sticky;top:0;z-index:5;display:flex;gap:.6em;align-items:center;padding:.5em .8em;background:#0b1a14ee;border-bottom:1px solid var(--line)}
#clock{color:var(--mira);font-family:monospace;font-size:1.1em}#sid{color:var(--dim);font-size:.75em;flex:1}
button{background:#10261d;color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:.35em .7em;font:inherit;font-size:.85em}
#stage{position:relative}#bg{height:34vh;background:#0e2a1f center/cover no-repeat;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:.8em}
#portrait{position:absolute;right:.6em;top:calc(34vh - 70px);width:84px;height:84px;border-radius:50%;border:2px solid var(--mira);background:#08302c center/cover;box-shadow:0 0 12px #3ff0e655}
#portrait:empty.none{display:none}#text{padding:1em;white-space:pre-wrap}
#choices{padding:0 .8em 2em;display:flex;flex-direction:column;gap:.6em}
.card{display:flex;gap:.7em;align-items:center;text-align:left;padding:.45em;border:1px solid var(--line);background:#0c1d16;border-radius:8px;position:relative}
.thumb{width:120px;height:90px;flex:none;border-radius:4px;background:#123526 center/cover;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:.65em}
.card .t{font-size:.8em;color:var(--dim)}.card.key{border-color:var(--key);box-shadow:inset 0 0 0 1px #7fd8b055}
.card.key::after{content:"◆ 关键";position:absolute;right:.4em;top:.3em;font-size:.65em;color:var(--key)}
.result{border-left:2px solid var(--mira);padding-left:.8em;color:#bfeee9}
.panel{position:fixed;inset:44px 0 0;max-width:560px;margin:auto;background:#07110df5;padding:1em;overflow:auto;z-index:4}.hidden{display:none}
.panel button{margin:.3em}.kmark{color:var(--key);font-size:.75em}
#logList li{margin:.4em 0}h2,h3{color:var(--mira);font-weight:500}

