+      const init = raw && typeof raw === "object" && !Array.isArray(raw) ? raw.init : raw;
+      vals[key] = clampValue(D, key, init === undefined ? 0 : init);
+    }
+    return {
+      scene: D.scenes[0].id,
+      vals,
+      flags: [],
+      mins: 0,
+      log: [],
+      keys: [],
+      bonuses: []
