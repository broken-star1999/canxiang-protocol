+    };
+    const parsePrimary = () => {
+      const t = peek();
+      if (t === undefined) throw new Error("缺少条件");
+      if (t === "(") {
+        i++;
+        const node = parseOr();
+        take(")");
+        return node;
+      }
+      if (t === "flag") {
+        i++;
+        take(":");
