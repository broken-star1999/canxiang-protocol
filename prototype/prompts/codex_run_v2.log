+P(`数据源: ${(D._sources || []).join(", ")}`);
+P(`场景 ${D.scenes.length} · 唯一状态 ${seen.size}${truncated ? "（已截断）" : ""} · 终点路径 ${ends.length} · endings ${(D.endings || []).length} · bonuses ${(D.bonuses || []).length} · self_endings ${(D.self_endings || []).length}`);
