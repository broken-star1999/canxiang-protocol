+      flags: [read_chat, login_mira, login_force, ignored_arm, edited_gate, mira_forced, trace_env, trace_arm, zhou_heard, zhou_letter, trace_he_zheng, trace_override, trace_pullback, jumper_removed]
+    scenes_file: chapters/c4/scenes.yaml
