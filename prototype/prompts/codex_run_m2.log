:root{--bg:#07110d;--fg:#cfe3d8;--dim:#6f8f80;--mira:#3ff0e6;--line:#1f3a2f;--key:#7fd8b0}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.75 system-ui,"PingFang SC","Noto Sans CJK SC",sans-serif;max-width:560px;margin:auto}
#hdr{position:sticky;top:0;z-index:5;display:flex;gap:.6em;align-items:center;padding:.5em .8em;background:#0b1a14ee;border-bottom:1px solid var(--line)}
#clock{color:var(--mira);font-family:monospace;font-size:1.1em}#sid{color:var(--dim);font-size:.75em;flex:1}
button{background:#10261d;color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:.35em .7em;font:inherit;font-size:.85em}
#stage{position:relative}#bg{height:34vh;background:#0e2a1f center/cover no-repeat;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:.8em}
#portrait{position:absolute;right:.6em;top:calc(34vh - 70px);width:84px;height:84px;border-radius:50%;border:2px solid var(--mira);background:#08302c center/cover;box-shadow:0 0 12px #3ff0e655}
#portrait:empty.none{display:none}#text{padding:1em;white-space:pre-wrap}
#choices{padding:0 .8em 2em;display:flex;flex-direction:column;gap:.6em}
.card{display:flex;gap:.7em;align-items:center;text-align:left;padding:.45em;border:1px solid var(--line);background:#0c1d16;border-radius:8px;position:relative}
.thumb{width:120px;height:90px;flex:none;border-radius:4px;background:#123526 center/cover;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:.65em}
.card .t{font-size:.8em;color:var(--dim)}.card.key{border-color:var(--key);box-shadow:inset 0 0 0 1px #7fd8b055}
.card.key::after{content:"◆ 关键";position:absolute;right:.4em;top:.3em;font-size:.65em;color:var(--key)}
.result{border-left:2px solid var(--mira);padding-left:.8em;color:#bfeee9}
.panel{position:fixed;inset:44px 0 0;max-width:560px;margin:auto;background:#07110df5;padding:1em;overflow:auto;z-index:4}.hidden{display:none}
.panel button{margin:.3em}.kmark{color:var(--key);font-size:.75em}
#logList li{margin:.4em 0}h2,h3{color:var(--mira);font-weight:500}
