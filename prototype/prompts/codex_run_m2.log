+- id: login_mira
+  type: knowledge
+  set_in: { chapter: c1, choice: c1_s01a_mira }
+  used_in: [c1, c2]
+  note: "报告草稿和 MIRA 的后续台词会提起这次维护登录。"
+- id: login_force
+  type: knowledge
+  set_in: { chapter: c1, choice: c1_s01a_force }
+  used_in: [c2]
+  note: "周衡会更早起疑。"
+- id: ignored_arm
+  type: misdirection
+  set_in: { chapter: c1, choice: c1_s00b_ignore }
+  used_in: [c2, c4]
+  note: "让唐棠的误导持续更久，并改变摘手套时的文本。"
+- id: read_plc
+  type: evidence
+  set_in: { chapter: c1, choice: c1_s02a_plc }
+  used_in: [fin]
+  note: "终章判断 K1 是否被人为短接的依据。"
+- id: bus_log
+  type: evidence
+  set_in: { chapter: c1, choice: c1_s02a_bus }
+  used_in: [fin]
+  note: "母线在急停后仍带电，是指认 K1 短接的独立证据。"
+- id: saw_jumper
+  type: evidence
+  set_in: { chapter: c1, choice: c1_s02b_go }
+  used_in: [fin]
+  note: "亲眼看见 K1 端子上的红色跳线。"
+- id: photo_jumper
+  type: evidence
+  set_in: { chapter: c1, choice: c1_s02c_photo }
+  used_in: [fin]
+  note: "保留跳线现场照片。"
+- id: jumper_removed
+  type: behavior
+  set_in: { chapter: c1, choice: c1_s02c_remove }
+  used_in: [c4, fin]
+  note: "第四章周衡会提起拆线；终章相应调整 EVD 与结局文本。"
+- id: edited_gate
+  type: behavior
+  set_in: { chapter: c1, choice: c1_s02c_cover }
+  used_in: [c1, c2, fin]
+  note: "影响第一章小结局、周衡的对峙台词和终章联署门槛。"
+- id: asked_pain
+  type: relationship
+  set_in: { chapter: c1, choice: c1_s03a_pain }
+  used_in: [c1, c2, c3, fin]
+  note: "与 mira_forced 一起派生 c1_mira；在第四章由 trace_arm 回收。"
+- id: mira_kept
+  type: relationship
+  set_in: { chapter: c1, choice: c1_s03b_keep }
+  used_in: [fin]
+  note: "MIRA 会在全篇复盘里提起你让她把副本留在自己手里。"
+- id: mira_copy
+  type: evidence
+  set_in: { chapter: c1, choice: c1_s03a_force / c1_s03b_give }
+  used_in: [fin]
+  note: "记录 MIRA 缓存副本是否交到玩家手中。"
+- id: mira_forced
+  type: key_flag
+  set_in: { chapter: c1, choice: c1_s03a_force }
+  used_in: [c2, c3, c4, fin]
