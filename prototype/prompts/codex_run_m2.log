+      flags: [read_chat, login_mira, login_force, ignored_arm, edited_gate, mira_forced, trace_env, trace_arm, zhou_heard, zhou_letter, trace_he_zheng]
+    scenes_file: chapters/c3/scenes.yaml
+    entry: c3_s00a
+    checkpoints: [c3_s00a, c3_s01a, c3_s02a, c3_s03a]
