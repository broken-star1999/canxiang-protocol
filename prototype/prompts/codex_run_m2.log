const SCN=Object.fromEntries(D.scenes.map(s=>[s.id,s]));
const IMG=D.images||{};const path=id=>IMG[id];
let st=E.initState(D),opt={showKey:false};
try{opt=Object.assign(opt,JSON.parse(localStorage.getItem("cx_opt")||"{}"))}catch(e){}
