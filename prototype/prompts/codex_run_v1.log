  EXP: { init: 0,  min: 0, max: 100 }
  SLF: { init: 0,  min: 0, max: 100 }

scenes:
  - id: a4_a                                # 内线电话
    bg: bg/corridor_amber
    portrait: char/zhou_press
    text:
      - "走廊尽头的对讲屏亮了。周衡的脸被冷光切成两半。"
      - "\"林述？我让你回宿舍。你回来干什么？\""
    choices:
      - id: a4_a_play
        label: "以林述的身份敷衍：\"拿点东西。\""
        thumb: thumb/a4_a_play.webp
        key: true                           # 关键抉择 K1 → 周旋线
        time: 2
