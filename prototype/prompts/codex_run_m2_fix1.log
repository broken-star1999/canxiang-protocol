chapters:
  - id: c1
    title: "第一章 · 急停"
    premise: "急停按下了，它却没有停。"
    cover: card_c1
    intro:
      - "雾岬站，2041 年 3 月 17 日，05:00。实验舱断电后，你在一副陌生的金属支架上醒来。"
      - "MIRA 叫你林述。急停按下了，机械臂却没有停；而系统记录里的每一条操作，都写着 LIN.S。"
      - "【本章推演目标】查清急停为什么失效，并决定你手里的东西交给谁。"
    unlock: { always: true }
    status: released
    clock: { start: "05:00", end: "05:30", closing_scene: c1_s04a }
    values_in:
      defaults: { EVD: 0, TRU: 30, EXP: 0, SLF: 0 }
      carry: {}
    imports: { echoes: [], flags: [] }
