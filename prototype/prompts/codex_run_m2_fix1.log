  P(`[${chapter.id} flags] 设置了无人使用：${unused.join(", ") || "无"}`);
  P(`[${chapter.id} flags] 引用上游已设置：${priorSetters.join(", ") || "无"}`);
  P(`[${chapter.id} flags] 由未上线章节设置：${[...futureSetters, ...localFuture].join(", ") || "无"}`);
