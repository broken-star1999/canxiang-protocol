    const laterUse = (record.used_in || []).some(id => chapterOrder.indexOf(id) > chapterOrder.indexOf(chapter.id));
    const laterImport = (D.chapters || []).some(other => chapterOrder.indexOf(other.id) > chapterOrder.indexOf(chapter.id) &&
