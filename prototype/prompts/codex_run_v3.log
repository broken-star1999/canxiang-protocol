+def add(key, *stems):
+    candidates = []
+    for stem_index, stem in enumerate(stems):
+        matcher = re.compile(r"^" + re.escape(stem) + r"_v(\d+)\.(webp|png)$", re.IGNORECASE)
+        for filename in art_files:
