# 第一章数值唯一来源 v1（谜题设计，2026-10-13），依据 puzzle/c1-balance-v3.md。
# 来源剧本：s00-s01 v4、s02 v2、s03 v4、s04 v2。只含 effects；time/flag 以剧本为准。
c1_s00a_look: { key: false, effects: { SLF: +5 } }
c1_s00a_answer: { key: false, effects: { TRU: +10, SLF: -5 } }
c1_s00b_move: { key: false, effects: { SLF: +5 } }
c1_s00b_ignore: { key: false, effects: { SLF: -5 } }
c1_s01a_pwd: { key: false, effects: { EXP: +5, SLF: -10 } }
c1_s01a_mira: { key: false, effects: { TRU: +10, EXP: +10 } }
c1_s01a_force: { key: false, effects: { EXP: +10, TRU: -10 } }
c1_s01b_chat: { key: false, effects: { EVD: +2 } }
c1_s01b_estop: { key: false, effects: {  } }
c1_s02a_plc: { key: false, effects: { EVD: +3 } }
c1_s02a_bus: { key: false, effects: { EVD: +6 } }
c1_s02a_env: { key: false, effects: { SLF: +5 } }
c1_s02a_done: { key: false, effects: {  } }
c1_s02b_go: { key: false, effects: { EVD: +6, EXP: +10 } }
c1_s02b_stay: { key: false, effects: {  } }
c1_s02c_photo: { key: false, effects: { EVD: +3 } }
c1_s02c_remove: { key: false, effects: { EVD: -5, SLF: +5, TRU: +5 } }
c1_s02c_cover: { key: false, effects: { EVD: +2, EXP: -10, TRU: -10 } }
c1_s03a_repair: { key: false, effects: { TRU: +10 } }
c1_s03a_pain: { key: false, effects: { TRU: +8, SLF: +5 } }
c1_s03a_force: { key: true, effects: { EVD: +10, TRU: -20 } }
c1_s03b_give: { key: false, effects: { EVD: +8, TRU: +5 } }
c1_s03b_keep: { key: false, effects: { TRU: +10 } }
c1_s03b_leave: { key: false, effects: {  } }
c1_s04a_mira: { key: true, effects: { TRU: +5 } }
c1_s04a_mail: { key: true, effects: { EVD: +5, EXP: +10 } }
c1_s04a_none: { key: true, effects: {  } }
# 第一章结局判定 + 联动奖励 v1（谜题设计，2026-10-13）
# 依据 proposal-v2 §4.1 与 puzzle/c1-balance-draft-v2.md。
# 终局三步各选项用 flags_set 记录：cause_K1/cause_WIRE/cause_AI/cause_OPEN，
# culprit_ZHOU/culprit_SYSTEM/culprit_LIN/culprit_SELF/culprit_WAIT，
# sign_R07/sign_LIN/sign_ANON，send_EXT/send_INT/send_NONE。
# 按顺序匹配，命中第一条即止。review 文案由编剧补。

bonuses:
  - id: b_zhou_both
    when: "flag:zhou_heard && flag:zhou_letter"
    effects: { EVD: +10 }
    once: true
    log: "你把电话里的话和那封没发出的信对上了。"

endings:
  - id: E_FORMAT          # E-格式化
    when: "EXP >= 85 || flag:cause_AI || (flag:culprit_SELF && !flag:send_NONE)"
    review: "……"
  - id: E_SCAPEGOAT       # E-替罪
    when: "flag:culprit_LIN && (flag:send_EXT || flag:send_INT)"
    review: "……"
  - id: E_ECHO_TRUE       # E-残响（真结局）
    when: "flag:cause_K1 && (flag:culprit_ZHOU || flag:culprit_SYSTEM) && flag:send_EXT && ((flag:sign_R07 && EVD >= 70) || (flag:sign_ANON && EVD >= 85)) && TRU >= 60"
    review: "……"
  - id: E_LONE            # E-孤证：同真结局条件，但证据或信任不足
    when: "flag:cause_K1 && (flag:culprit_ZHOU || flag:culprit_SYSTEM) && flag:send_EXT && ((flag:sign_R07 && EVD >= 50) || (flag:sign_ANON && EVD >= 65))"
    review: "……"
  - id: E_HALFWAKE        # E-半醒
    when: "flag:sign_LIN && flag:send_EXT"
    review: "……"
  - id: E_ZHOU            # E-回声（周衡线），TRU 高低两版文本
    when: "flag:culprit_WAIT || (flag:culprit_SYSTEM && flag:zhou_heard)"
    variant: "TRU >= 60"
    review: "……"
  - id: E_SILENT          # E-沉默，TRU 高低两版文本
    when: "flag:send_NONE || flag:send_INT"
    variant: "TRU >= 60"
    review: "……"
  - id: E_LONE_FALLBACK   # 兜底
    when: "EVD >= 50"
    same_as: E_LONE
  - id: E_FORMAT_FALLBACK
    when: "true"
    same_as: E_FORMAT

self_endings:             # 与事件结局叠加
  - { id: S_SHADOW, when: "SLF < 35" }
  - { id: S_BETWEEN, when: "SLF >= 35 && SLF < 65" }
  - { id: S_R07, when: "SLF >= 65" }

# 匿名发送的 EVD 门槛 +15 已直接写进真结局和孤证的条件。
---../story/c1_s00-s01_draft_v4.yaml
      一个是组内聊天，未读 47 条，最上面一条是周衡发的，时间 3 月 14 日。
      另一个是急停系统的事件日志，图标是红色的，已经红了三个小时。
    choices:
      - id: c1_s01b_chat
        label: "先看聊天记录"
        key: false
        thumb: c1_s01b_chat
        effects: { EVD: +5 }
        time: 3
        flags_set: [read_chat]
        result: |
          你往上翻。大多是订饭、催报告、吐槽误触发。然后是 3 月 14 日，周衡的一句：
          "林述你那密码还是'蜗牛'那套吧？全组都知道哈哈。"
          后面跟着三个人的"哈哈"。你盯着那行字看了很久。原来不只是你记得这个密码。
        log: "你翻到了周衡调侃密码的聊天记录：全组都知道 LIN.S 的密码。"
        next: c1_s02a
      - id: c1_s01b_estop
        label: "直接打开急停日志"
        key: false
        thumb: c1_s01b_estop
        effects: {}
        time: 1
        result: |
          聊天可以以后再看。你点开那个红色图标。
          第一行是 02:13:07。PB1 按下。
          你还没往下读，就已经觉得冷了。
        log: "你跳过聊天记录，直接打开了急停日志。"
        next: c1_s02a
---../story/c1_s02_draft_v2.yaml
      - id: c1_s02c_remove
        label: "拆掉它，至少别再伤人"
        key: false
        thumb: c1_s02c_remove
        effects: { EVD: -15, SLF: +5, TRU: +5 }
        time: 2
        flags_set: [jumper_removed]
        result: |
          你捏住线头，往外一拔。比想象中容易。
          K1 的指示灯跳了一下，回到它本来该在的状态。从这一秒起，急停又是急停了。
          你攥着那截红线站了一会儿。现场没了，你手里只剩一截谁都能剪出来的电线。
          "你……先想到了人。"MIRA 很轻地说。
        log: "你拆掉了跳线。急停恢复了，现场也没了。"
        next: c1_s03a
      - id: c1_s02c_cover
        label: "拍照后把门禁改成「维护」"
        key: false
        thumb: c1_s02c_cover
        effects: { EVD: +5, EXP: -15, TRU: -10 }
        time: 5
        flags_set: [photo_jumper, edited_gate]
        result: |
          照片拍好了。你回到终端，在门禁记录里把那一行的事由改成"例行维护"。
          改完你才发觉，这个动作很熟练。
          "你和他……"MIRA 的波形抖了一下，"做了一样的事。"
          你想解释，又不知道该说什么。
        log: "你拍了照，又把自己的门禁记录改成了维护。MIRA 看见了。"
        next: c1_s03a
---../story/c1_s03_draft_v4.yaml
        next: c1_s04a
      - id: c1_s03b_keep
        label: "「你自己留着，那是你的。」"
        key: false
        when: "TRU >= 50"
        thumb: c1_s03b_keep
        effects: { TRU: +15 }
        time: 1
        flags_set: [mira_kept]
        result: |
          你把交接请求撤了回去。
          波形顿了一下，像是没听懂，又像是听懂了不敢信。
          「……那，我收好。」
          索引慢慢合上。你手里少了一份证据。她心里多了一件，以后会提起的事。
        log: "你没有拿走副本。你说，那是她的。"
        next: c1_s04a
      - id: c1_s03b_leave
        label: "先不问了，走吧"
        key: false
        thumb: c1_s03b_leave
        effects: {}
        time: 0
        result: |
          你没有开口。时间不够，或者是你还没想好该怎么开口。
          那道波形亮了一下，像是有话要说。
          最后她什么也没说，只是把索引窗口留在屏幕上，没有关。
        log: "你没有问 MIRA 要副本，就离开了。"
        next: c1_s04a
---../story/c1_s04_draft_v2.yaml
          附件，四个。发送。
          「已发送」的提示音很轻快，像一句毫不知情的「好的」。
          然后，站内广播响了第二声。不是提示音。是有人拿起了话筒。
        log: "你把证据发到了林述的私人邮箱。广播响了第二声。"
        next: c1_end
      - id: c1_s04a_none
        label: "先什么都不动，去问个明白"
        key: true
        echo_set: { c1_cache: none }
        thumb: c1_s04a_none
        effects: {}
        time: 1
        result: |
          藏起来，就是承认自己需要躲。你不想躲。
          那三行字不是你写的。你要当面问，问写下它们的人，为什么是你的名字。
          你把报告关掉，所有证据原样留在本地，像一份摊开在桌上的答卷。
          你知道这很冒险。可是只有心虚的人，才急着藏。
        log: "你没有藏起证据，决定当面去问个明白。"
        next: c1_end

  - id: c1_end
    bg: scene_corridor_intercom
    text: |
      你往走廊尽头走。应急灯一盏一盏在头顶滑过去。
      你想起唐棠。想起她下周本来要修的那个接头。想起报告第四页上，那三颗已经敲好的钉子。
      有人要让林述背下这件事。
      而你就是林述。
      走廊尽头，那块对讲屏亮了。

