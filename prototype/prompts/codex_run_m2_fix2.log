}
button:hover { border-color: var(--mint); }
button:disabled { opacity: .5; cursor: default; }
.primary { border-color: #3c9f8e; background: #12372f; }
.secondary { background: #111c18; }
.hidden { display: none !important; }
#hdr {
  position: sticky;
  z-index: 10;
  top: 0;
  display: flex;
  align-items: center;
  gap: .6em;
  min-height: 48px;
  padding: .45em .7em;
  border-bottom: 1px solid var(--line);
  background: #0b1a14ee;
  backdrop-filter: blur(8px);
}
#hdr .brand { border: 0; padding-left: 0; font-weight: 650; background: transparent; }
#clock { color: var(--mint); font: 1.05em ui-monospace, monospace; }
#sceneId { flex: 1; color: var(--muted); font-size: .75em; }
#hdr nav { display: flex; gap: .3em; }
#hdr nav button { padding: .25em .5em; font-size: .78em; }
#globalMsg { margin: 0; padding: 0 .9em; color: var(--muted); font-size: .82em; }
.notice { color: #ffcc84 !important; }
#app { padding: 0 .9em 4em; }
.view { min-height: 65vh; padding: 1.2em 0; }
.title-view { display: flex; min-height: 78vh; flex-direction: column; justify-content: center; align-items: flex-start; padding: 2em; }
.title-mark, .eyebrow { color: var(--mint); font: .75em ui-monospace, monospace; letter-spacing: .18em; }
.title-view h1 { margin: .1em 0; font-size: clamp(2.5em, 12vw, 4.8em); font-weight: 450; letter-spacing: .12em; }
.title-view p { color: var(--muted); }
.title-actions, .actions { display: flex; flex-wrap: wrap; gap: .6em; margin-top: 1.5em; }
.page-heading { padding: .6em 0 1.2em; }
h1, h2, h3 { color: #d8eee4; font-weight: 520; line-height: 1.35; }
h1 { margin: .1em 0 .4em; }
h2 { margin: 1.1em 0 .45em; font-size: 1.25em; }
h3 { margin: 1em 0 .35em; font-size: 1em; }
.muted { color: var(--muted); }
.chapter-list { display: grid; gap: 1em; }
.chapter-card { display: grid; grid-template-columns: minmax(90px, 28%) 1fr; gap: .9em; align-items: center; padding: .65em; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
.chapter-cover { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 6px; background: #142c22; color: var(--muted); }
.chapter-cover.locked-cover { filter: grayscale(1) brightness(.25); }
.chapter-cover.missing-cover { display: grid; place-items: center; color: var(--muted); }
.chapter-copy h2 { margin: 0; font-size: 1.05em; }
.chapter-copy p { margin: .35em 0; font-size: .87em; }
.chapter-copy .chapter-status { color: var(--mint); font-size: .78em; }
.chapter-card > button { grid-column: 1 / -1; }
.echo-icons { display: flex; gap: .4em; padding-top: .2em; }
.echo-dot { width: 19px; height: 19px; border-radius: 50%; background-position: center; background-size: contain; background-repeat: no-repeat; border: 1px solid #477267; }
.text-button { border: 0; padding: .2em 0; background: none; color: var(--mint); }
.intro-copy { margin-top: 1.4em; }
.intro-copy p { margin: 1.2em 0; }
.scene-bg { display: flex; min-height: 28vh; align-items: center; justify-content: center; border: 1px solid #163529; border-radius: 10px; background: #0d2b20 center / cover no-repeat; color: var(--muted); font-size: .78em; text-align: center; }
.scene-text { position: relative; min-height: 7em; padding: 1.1em .35em; white-space: pre-wrap; }
.portrait { position: relative; z-index: 2; width: 94px; height: 94px; margin: -78px 1em 0 auto; border: 2px solid var(--mint); border-radius: 50%; background: #08302c center / cover no-repeat; box-shadow: 0 0 12px #3ff0e655; }
.choice-list { display: grid; gap: .65em; padding: .2em 0 2em; }
.choice-card { display: flex; width: 100%; align-items: center; gap: .75em; padding: .55em; text-align: left; background: var(--card); }
.choice-thumb { display: flex; flex: 0 0 108px; height: 78px; align-items: center; justify-content: center; border-radius: 5px; background: #123526 center / cover no-repeat; color: var(--muted); font-size: .7em; }
.choice-body { display: grid; gap: .25em; }
.choice-body small { color: var(--muted); }
.choice-card.key-choice { border-color: var(--key); box-shadow: inset 0 0 0 1px #7fd8b055; }
.choice-card.key-choice::after { content: "◆ 关键"; align-self: start; margin-left: auto; color: var(--key); font-size: .68em; }
.review-content { padding-bottom: 1em; }
.review-content > p { white-space: pre-wrap; }
.ending-image { min-height: 180px; border-radius: 9px; background: #11251d center / cover no-repeat; color: var(--muted); display: grid; place-items: center; }
.safety-card { border-left: 3px solid #d3ab6e; padding: .5em .8em; background: #1c2018; }
.curve-table, .echo-table { width: 100%; border-collapse: collapse; font-size: .86em; }
.curve-table th, .curve-table td, .echo-table td { padding: .35em .5em; border-bottom: 1px solid var(--line); text-align: left; }
.collection-row, .archive-chapter { margin: 1em 0; }
.ending-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .4em; }
.ending-cell { display: flex; min-height: 65px; align-items: center; justify-content: center; padding: .35em; border: 1px solid var(--line); border-radius: 6px; background: #0c1c15 center / cover no-repeat; color: var(--muted); text-align: center; font-size: .72em; }
.ending-cell.achieved { color: white; text-shadow: 0 1px 4px #000; }
.fin-matrix { display: grid; gap: .35em; }
.fin-matrix-row { display: grid; grid-template-columns: minmax(78px, 1.25fr) repeat(3, minmax(0, 1fr)); gap: .35em; }
.fin-ending-label { display: flex; align-items: center; padding: .35em; color: var(--fg); font-size: .75em; }
.fin-matrix-row .ending-cell { min-height: 44px; }
.run-details { padding: .5em 0; border-bottom: 1px solid var(--line); }
.run-details summary { cursor: pointer; color: var(--mint); }
.review-links { display: flex; flex-direction: column; align-items: flex-start; gap: .4em; }
.panel { position: fixed; z-index: 15; inset: 50px 0 0; max-width: 720px; margin: auto; padding: 1em; overflow: auto; border: 1px solid var(--line); background: #07110df5; }
.panel button { margin: .25em; }
.panel li { margin: .35em 0; }
.log-time { color: var(--mint); font: .8em ui-monospace, monospace; }
.key-mark { margin-left: .5em; color: var(--key); font-size: .8em; }
.toggle { display: block; margin: .8em 0; }
.dialog { position: fixed; z-index: 30; inset: 0; display: grid; place-items: center; padding: 1em; background: #000b; }
.dialog-card { width: min(100%, 560px); padding: 1em; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); }
.dialog textarea { width: 100%; resize: vertical; padding: .6em; color: var(--fg); background: #06100b; border: 1px solid var(--line); font: .8em ui-monospace, monospace; }
@media (max-width: 480px) {
  #hdr { gap: .35em; padding-inline: .45em; }
  #hdr nav { gap: .15em; }
  #hdr nav button { padding: .22em .36em; font-size: .7em; }
  .chapter-card { grid-template-columns: 26% 1fr; }
  .chapter-copy p { font-size: .8em; }
  .choice-thumb { flex-basis: 86px; height: 68px; }
  .ending-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .fin-matrix-row { grid-template-columns: minmax(64px, 1fr) repeat(3, minmax(0, 1fr)); gap: .2em; }
  .fin-ending-label, .fin-matrix-row .ending-cell { padding-inline: .2em; font-size: .65em; }
}

