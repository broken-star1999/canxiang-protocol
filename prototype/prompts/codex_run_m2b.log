+  }
+  function imagePath(key) { return (D.images || {})[key] || null; }
+  function setImage(element, key, placeholder) {
+    const src = imagePath(key);
+    element.style.backgroundImage = "";
+    element.textContent = placeholder || "";
+    if (!src) return;
+    const image = new Image();
+    image.onload = () => {
