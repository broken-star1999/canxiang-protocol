+  }
+
+  function initPanels() {
+    document.querySelectorAll("nav [data-panel]").forEach(buttonEl => {
+      buttonEl.onclick = () => {
+        const panel = $("#" + buttonEl.dataset.panel);
+        const open = panel.classList.contains("hidden");
