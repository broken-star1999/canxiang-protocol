+        if (open) panel.classList.remove("hidden");
+      };
+    });
+    $("#closeCodeDialog").onclick = () => $("#saveCodeDialog").classList.add("hidden");
+  }
+
+  safeLoad();
+  setTopNav();
+  initPanels();
+  showView("titleView");
+})();
