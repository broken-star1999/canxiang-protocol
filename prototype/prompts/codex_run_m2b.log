+    $("#sceneText").textContent = choice.result || "";
+    $("#sceneBg").textContent = "";
+    const list = $("#choiceList");
+    list.replaceChildren(button("继续 ▸", () => {
+      awaitingResult = false;
+      const current = scenesByChapter[activeChapter.id][state.scene];
+      if (current && !(current.choices || []).length) {
+        renderGame();
+        return;
