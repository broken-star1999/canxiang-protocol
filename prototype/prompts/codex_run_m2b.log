+    run.finishedAt = new Date().toISOString();
+    run.valuesOut = E.clone(state.vals);
+    run.echoesOut = exportedEchoes;
+    run.flagsOut = (exports.flags || []).filter(flag => state.flags.includes(flag));
+    run.bonuses = E.clone(state.bonuses);
