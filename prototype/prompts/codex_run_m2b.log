+        for (const echoId of imports) {
+          const def = (D.echoes || []).find(item => item.id === echoId);
+          const current = mainEchoValue(chapter.id, echoId);
+          const icon = node("span", current ? "" : "", "echo-dot");
+          if (def && imagePath("icon:" + def.icon)) {
