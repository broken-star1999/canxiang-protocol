+      }
+      if (kind === "VP8 " && data[23] === 0x9d && data[24] === 0x01 && data[25] === 0x2a) {
+        return { width: data.readUInt16LE(26) & 0x3fff, height: data.readUInt16LE(28) & 0x3fff };
+      }
+    }
+  } catch (_) { /* Report dimensions as unavailable below. */ }
+  return null;
