#!/usr/bin/env python3
"""Merge chapter YAML and art assets into data.json / data.js."""
import glob
import json
import os
import re

import yaml

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)


def natural_key(value):
    return tuple(int(part) if part.isdigit() else part.casefold()
                 for part in re.split(r"(\d+)", value))


def latest(files, rx):
    best = {}
    for filename in sorted(files):
        match = re.match(rx, os.path.basename(filename))
        if not match:
            continue
        key, version = match.group(1), int(match.group(2))
        if key not in best or version > best[key][0]:
            best[key] = (version, filename)
    return [best[key][1] for key in sorted(best, key=natural_key)]


def load_yaml(filename):
    with open(filename, encoding="utf-8") as stream:
        return yaml.safe_load(stream) or {}


story_segments = latest(
    glob.glob(os.path.join(ROOT, "story", "*.yaml")),
    r"(.+?)_draft_v(\d+)\.ya?ml$",
)
puzzle_sources = latest(
    glob.glob(os.path.join(ROOT, "puzzle", "*endings_v*.yaml")),
    r"(.*endings)_v(\d+)\.ya?ml$",
)
D = {
    "values": {}, "clock_start": "00:00", "scenes": [], "endings": [],
    "bonuses": [], "self_endings": [], "portrait_overrides": [],
    "_sources": [], "_portrait_override_sources": [],
    "_portrait_override_skipped": [],
}
story_override_pairs = set()


def merge_chapter_data(filename, *, first_segment=False, is_story=False):
    data = load_yaml(filename)
    relative = os.path.relpath(filename, ROOT).replace(os.sep, "/")
    if first_segment:
        D["values"] = data.get("values", {})
        D["clock_start"] = data.get("clock_start", "00:00")
    D["scenes"] += data.get("scenes") or []
    for key in ("endings", "bonuses", "self_endings"):
        D[key] += data.get(key) or []
    overrides = data.get("portrait_overrides") or []
    if isinstance(overrides, list):
        for override in overrides:
            if not isinstance(override, dict):
                continue
            D["portrait_overrides"].append(override)
            D["_portrait_override_sources"].append(relative)
            if is_story:
                story_override_pairs.add((override.get("from"), override.get("to")))
    D["_sources"].append(relative)


for index, filename in enumerate(story_segments):
    merge_chapter_data(filename, first_segment=index == 0, is_story=True)
for filename in puzzle_sources:
    merge_chapter_data(filename)

# Prototype-specific overrides are deliberately lower priority than chapter data.
prototype_overrides = os.path.join(HERE, "overrides.yaml")
if os.path.exists(prototype_overrides):
    data = load_yaml(prototype_overrides)
    relative = os.path.relpath(prototype_overrides, ROOT).replace(os.sep, "/")
    for override in data.get("portrait_overrides") or []:
        if not isinstance(override, dict):
            continue
        pair = (override.get("from"), override.get("to"))
        if pair in story_override_pairs:
            D["_portrait_override_skipped"].append(relative)
            continue
        D["portrait_overrides"].append(override)
        D["_portrait_override_sources"].append(relative)
    D["_sources"].append(relative)


# Scan art/out once. Ignore generated drafts at any directory depth.
ART_OUT = os.path.join(ROOT, "art", "out")
art_files = []
if os.path.isdir(ART_OUT):
    for directory, subdirs, filenames in os.walk(ART_OUT):
        subdirs[:] = [name for name in subdirs if name != "_draft_genimage"]
        for filename in filenames:
            if filename.lower().endswith((".webp", ".png")):
                art_files.append(os.path.join(directory, filename))

imgs = {}


def add(key, *stems):
    candidates = []
    for stem_index, stem in enumerate(stems):
        matcher = re.compile(r"^" + re.escape(stem) + r"_v(\d+)\.(webp|png)$", re.IGNORECASE)
        for filename in art_files:
            match = matcher.match(os.path.basename(filename))
            if match:
                version = int(match.group(1))
                webp = match.group(2).lower() == "webp"
                candidates.append((version, webp, -stem_index, filename))
    if candidates:
        chosen = max(candidates, key=lambda item: (item[0], item[1], item[2], item[3]))[3]
        imgs[key] = os.path.relpath(chosen, HERE).replace(os.sep, "/")


def add_portrait(name):
    if name:
        add(name, "portrait_" + name, name)


fallback = {
    "scene_bay7_poweroff": "../samples/scene_bay7_poweroff_v2.png",
    "mira_lv1": "../samples/portrait_mira_lv1_v1.png",
}
for scene in D["scenes"]:
    if scene.get("bg"):
        add(scene["bg"], scene["bg"])
    add_portrait(scene.get("portrait"))
    for choice in scene.get("choices") or []:
        add("thumb:" + choice["id"], "thumb_" + choice["id"])
for ending in D["endings"]:
    add("ending:" + ending["id"], "ending_" + ending["id"])
for override in D["portrait_overrides"]:
    add_portrait(override.get("to"))
for key, filename in fallback.items():
    if key not in imgs and os.path.exists(os.path.join(HERE, filename)):
        imgs[key] = filename
D["images"] = imgs

serialized = json.dumps(D, ensure_ascii=False, indent=1)
with open(os.path.join(HERE, "data.json"), "w", encoding="utf-8") as stream:
    stream.write(serialized)
with open(os.path.join(HERE, "data.js"), "w", encoding="utf-8") as stream:
    stream.write("window.STORY=" + serialized + ";")

print(
    "sources:", *D["_sources"],
    f"| scenes={len(D['scenes'])} endings={len(D['endings'])} "
    f"bonuses={len(D['bonuses'])} portrait_overrides={len(D['portrait_overrides'])} "
    f"images={len(imgs)}",
)
for override, source in zip(D["portrait_overrides"], D["_portrait_override_sources"]):
    print("portrait_override:", source, override)
for source in D["_portrait_override_skipped"]:
    print("portrait_override duplicate skipped:", source, "(story already has the same from+to)")
// Shared browser/Node game logic.
(function (G) {
  const clone = o => JSON.parse(JSON.stringify(o));
  const own = (o, k) => Object.prototype.hasOwnProperty.call(o || {}, k);
  const warned = new Set();
  const parsed = new Map();
  const BAD = {};

  function warnOnce(key, message) {
    if (warned.has(key)) return;
    warned.add(key);
    if (typeof console !== "undefined" && console.warn) console.warn(message);
  }

  function valueConfig(D, key) {
    const v = (D.values || {})[key];
    return v && typeof v === "object" && !Array.isArray(v) ? v : null;
  }

  function clampValue(D, key, value) {
    const config = valueConfig(D, key);
    let n = Number(value);
    if (!Number.isFinite(n)) n = 0;
    if (config && config.min !== undefined) n = Math.max(Number(config.min), n);
    if (config && config.max !== undefined) n = Math.min(Number(config.max), n);
    return n;
  }

  function initState(D) {
    const vals = {};
    for (const [key, raw] of Object.entries(D.values || {})) {
      const init = raw && typeof raw === "object" && !Array.isArray(raw) ? raw.init : raw;
      vals[key] = clampValue(D, key, init === undefined ? 0 : init);
    }
    return {
      scene: D.scenes[0].id,
      vals,
      flags: [],
      mins: 0,
      log: [],
      keys: [],
      bonuses: []
    };
  }

  function hm(start, m) {
    const [h, mm] = (start || "00:00").split(":").map(Number);
    const t = h * 60 + mm + m;
    return String(Math.floor(t / 60) % 24).padStart(2, "0") + ":" + String(t % 60).padStart(2, "0");
  }

  function tokenize(source) {
    const tokens = [];
    const re = /\s*(>=|<=|==|!=|&&|\|\||[()!<>\[\],]|:|(?:\d+(?:\.\d*)?|\.\d+)|[A-Za-z_][A-Za-z0-9_.-]*)/y;
    let i = 0;
    while (i < source.length) {
      if (!source.slice(i).trim()) break;
      re.lastIndex = i;
      const m = re.exec(source);
      if (!m) throw new Error("无效字符");
      tokens.push(m[1]);
      i = re.lastIndex;
    }
    return tokens;
  }

  function parseExpression(source) {
    const tokens = tokenize(source);
    let i = 0;
    const peek = () => tokens[i];
    const take = t => {
      if (tokens[i] !== t) throw new Error("缺少 " + t);
      i++;
    };
    const parsePrimary = () => {
      const t = peek();
      if (t === undefined) throw new Error("缺少条件");
      if (t === "(") {
        i++;
        const node = parseOr();
        take(")");
        return node;
      }
      if (t === "flag") {
        i++;
        take(":");
        const name = peek();
        if (!name || !/^[A-Za-z_][A-Za-z0-9_.-]*$/.test(name)) throw new Error("flag 名无效");
        i++;
        return { type: "flag", name };
      }
      if (t === "true" || t === "false") {
        i++;
        return { type: "literal", value: t === "true" };
      }
      if (/^(?:\d+(?:\.\d*)?|\.\d+)$/.test(t)) {
        i++;
        return { type: "literal", value: Number(t) };
      }
      if (/^[A-Za-z_][A-Za-z0-9_.-]*$/.test(t)) {
        i++;
        return { type: "name", name: t };
      }
      throw new Error("条件项无效");
    };
    const parseComparison = () => {
      const left = parsePrimary();
      if (peek() === "in") {
        i++;
        take("[");
        const items = [];
        if (peek() !== "]") {
          while (true) {
            items.push(parsePrimary());
            if (peek() !== ",") break;
            i++;
          }
        }
        take("]");
        return { type: "in", left, items };
      }
      if ([">", ">=", "<", "<=", "==", "!="].includes(peek())) {
        const op = tokens[i++];
        return { type: "compare", op, left, right: parsePrimary() };
      }
      return { type: "truthy", value: left };
    };
    const parseUnary = () => {
      if (peek() === "!") {
        i++;
        return { type: "not", value: parseUnary() };
      }
      return parseComparison();
    };
    const parseAnd = () => {
      let node = parseUnary();
      while (peek() === "&&") {
        i++;
        node = { type: "and", left: node, right: parseUnary() };
      }
      return node;
    };
    const parseOr = () => {
      let node = parseAnd();
      while (peek() === "||") {
        i++;
        node = { type: "or", left: node, right: parseAnd() };
      }
      return node;
    };
    const ast = parseOr();
    if (i !== tokens.length) throw new Error("条件末尾有多余内容");
    return ast;
  }

  function conditionKey(condition) {
    try { return JSON.stringify(condition); }
    catch (_) { return String(condition); }
  }

  function parseCached(source) {
    const key = String(source);
    if (parsed.has(key)) return parsed.get(key);
    try {
      const ast = parseExpression(key);
      parsed.set(key, ast);
      return ast;
    } catch (_) {
      parsed.set(key, BAD);
      warnOnce("expr:" + key, "条件解析失败，按 false 处理：" + key);
      return BAD;
    }
  }

  function resolve(node, st) {
    if (node.type === "literal") return node.value;
    if (node.type === "flag") return (st.flags || []).includes(node.name);
    if (node.type === "name") {
      if (own(st.vals, node.name)) return Number(st.vals[node.name]);
      return { symbol: node.name, unresolved: true };
    }
    return undefined;
  }

  function isUnresolvedName(node, st) {
    return node && node.type === "name" && !own(st.vals, node.name);
  }

  function comparableEqual(a, b) {
    if (typeof a === "number" && typeof b === "number") return a === b;
    if (typeof a === "boolean" && typeof b === "boolean") return a === b;
    if (a && b && a.unresolved && b.unresolved) return a.symbol === b.symbol;
    return false;
  }

  function compare(node, st) {
    const a = resolve(node.left, st);
    const b = resolve(node.right, st);
    if ((node.op === "==" || node.op === "!=") && isUnresolvedName(node.left, st) && b && b.unresolved) {
      const has = (st.flags || []).includes(node.left.name + "=" + b.symbol);
      return node.op === "==" ? has : !has;
    }
    if (node.op === "==") return comparableEqual(a, b);
    if (node.op === "!=") return !comparableEqual(a, b);
    if (typeof a !== "number" || typeof b !== "number") return false;
    if (node.op === ">") return a > b;
    if (node.op === ">=") return a >= b;
    if (node.op === "<") return a < b;
    if (node.op === "<=") return a <= b;
    return false;
  }

  function evalAst(node, st) {
    switch (node.type) {
      case "literal": return !!node.value;
      case "flag": return (st.flags || []).includes(node.name);
      case "truthy": {
        const value = resolve(node.value, st);
        return typeof value === "number" ? value !== 0 : typeof value === "boolean" ? value : false;
      }
      case "not": return !evalAst(node.value, st);
      case "and": return evalAst(node.left, st) && evalAst(node.right, st);
      case "or": return evalAst(node.left, st) || evalAst(node.right, st);
      case "compare": return compare(node, st);
      case "in": {
        if (isUnresolvedName(node.left, st)) {
          return node.items.some(item => {
            const value = resolve(item, st);
            if (value && value.unresolved) return (st.flags || []).includes(node.left.name + "=" + value.symbol);
            return (st.flags || []).includes(node.left.name + "=" + String(value));
          });
        }
        const left = resolve(node.left, st);
        return node.items.some(item => comparableEqual(left, resolve(item, st)));
      }
      default: return false;
    }
  }

  function evalConditionObject(condition, st) {
    const keys = Object.keys(condition);
    if (!keys.length || keys.some(k => k !== "all" && k !== "any")) {
      warnOnce("object:" + conditionKey(condition), "条件对象格式无效，按 false 处理：" + conditionKey(condition));
      return false;
    }
    for (const key of keys) {
      const list = condition[key];
      if (!Array.isArray(list)) {
        warnOnce("object:" + conditionKey(condition), "条件对象格式无效，按 false 处理：" + conditionKey(condition));
        return false;
      }
      const results = list.map(item => {
        if (typeof item !== "string" && (!item || typeof item !== "object" || Array.isArray(item))) {
          warnOnce("object:" + conditionKey(condition), "条件对象元素无效，按 false 处理：" + conditionKey(condition));
          return false;
        }
        return evalWhen(item, st);
      });
      if (key === "all" && !results.every(Boolean)) return false;
      if (key === "any" && !results.some(Boolean)) return false;
    }
    return true;
  }

  function evalWhen(condition, st) {
    if (condition === undefined || condition === null) return true;
    if (typeof condition === "boolean") return condition;
    if (typeof condition === "object" && !Array.isArray(condition)) return evalConditionObject(condition, st);
    if (typeof condition !== "string") {
      warnOnce("condition:" + conditionKey(condition), "条件格式无效，按 false 处理：" + conditionKey(condition));
      return false;
    }
    const ast = parseCached(condition);
    if (ast === BAD) return false;
    try { return !!evalAst(ast, st); }
    catch (_) {
      warnOnce("eval:" + condition, "条件求值失败，按 false 处理：" + condition);
      return false;
    }
  }

  function resolvePortrait(D, scene, st) {
    const original = scene && scene.portrait;
    if (!original) return original;
    for (const override of D.portrait_overrides || []) {
      if (override && override.from === original && evalWhen(override.when, st)) {
        return override.to;
      }
    }
    return original;
  }

  function flagList(value, field, choiceId) {
    if (value === undefined) return [];
    if (value === null) {
      warnOnce("flags:" + field + ":" + choiceId + ":null", field + " 格式无效，按不满足处理：" + choiceId);
      return null;
    }
    const list = Array.isArray(value) ? value : [value];
    if (list.every(x => typeof x === "string")) return list;
    warnOnce("flags:" + field + ":" + choiceId + ":" + conditionKey(value), field + " 格式无效，按不满足处理：" + choiceId);
    return null;
  }

  function visibleChoices(scene, st) {
    return (scene && scene.choices || []).filter(choice => {
      if (own(choice, "when") && !evalWhen(choice.when, st)) return false;
      if (own(choice, "requires")) {
        const required = flagList(choice.requires, "requires", choice.id);
        if (!required || !required.every(f => (st.flags || []).includes(f))) return false;
      }
      if (own(choice, "hide_if")) {
        const hidden = flagList(choice.hide_if, "hide_if", choice.id);
        if (!hidden || hidden.some(f => (st.flags || []).includes(f))) return false;
      }
      return true;
    });
  }

  function eff(st, effects, D) {
const D=window.STORY,E=window.Engine,$=s=>document.querySelector(s);
const SCN=Object.fromEntries(D.scenes.map(s=>[s.id,s]));
const IMG=D.images||{};const path=id=>IMG[id];
let st=E.initState(D),opt={showKey:false};
try{opt=Object.assign(opt,JSON.parse(localStorage.getItem("cx_opt")||"{}"))}catch(e){}
function setImg(el,id,label){el.style.backgroundImage="";el.textContent=id?label||id:"";if(!id||!path(id))return;const i=new Image();i.onload=()=>{el.style.backgroundImage=`url(${i.src})`;el.textContent=""};i.src=path(id)}
function render(){const s=SCN[st.scene];$("#clock").textContent=E.hm(D.clock_start||"00:00",st.mins);renderSide();
 if(!s)return finish();$("#sid").textContent=s.id;setImg($("#bg"),s.bg,"［"+s.bg+"］");const p=$("#portrait"),portrait=E.resolvePortrait(D,s,st);p.className=portrait?"":"none";p.style.display=portrait?"":"none";setImg(p,portrait,"MIRA");
 $("#text").textContent=Array.isArray(s.text)?s.text.join("\n"):s.text||"";const box=$("#choices");box.innerHTML="";
 for(const c of E.visibleChoices(s,st)){const b=document.createElement("button");b.className="card"+(c.key&&opt.showKey?" key":"");
  b.innerHTML=`<div class="thumb"></div><div><div>${c.label}</div><div class="t">+${c.time||0} 分钟</div></div>`;setImg(b.querySelector(".thumb"),"thumb:"+c.id,"缩略图");
  b.onclick=()=>choose(c);box.appendChild(b)}
 if(!(s.choices||[]).length)finish()}
function choose(c){E.apply(st,c,D);renderSide();$("#clock").textContent=E.hm(D.clock_start,st.mins);
 $("#text").innerHTML="";const r=document.createElement("div");r.className="result";r.textContent=c.result||"";$("#text").appendChild(r);
 const box=$("#choices");box.innerHTML="";const b=document.createElement("button");b.textContent="继续 ▸";b.onclick=render;box.appendChild(b);scrollTo(0,0)}
function finish(){const e=SCN[st.scene]?E.ending(D,st):null;$("#sid").textContent=e?e.id:"END";$("#portrait").style.display="none";
 const bg=$("#bg");if(e)setImg(bg,"ending:"+e.shown,"［ending_"+e.shown+"］");else{bg.style.backgroundImage="";bg.textContent=""}
 const ver=e&&e.high!==null?(e.high?"（高信任版）":"（低信任版）"):"";
 const rev=e?(e.review||"〔复盘文案待编剧补写："+e.shown+ver+"〕"):"（第一章后续未写；next → "+st.scene+"）";
 $("#text").innerHTML=`<h2>${e?"结局 "+e.id+ver:"本段结束"}</h2>${e&&e.selves.length?`<p class="t">自我结局：${e.selves.join(" / ")}</p>`:""}<p>${rev}</p><h3>你做过的关键抉择</h3><ul>${st.keys.map(k=>"<li>◆ "+k+"</li>").join("")||"<li>（无）</li>"}</ul><p class="t">用时 ${st.mins} 分钟 · 终点 ${E.hm(D.clock_start,st.mins)}</p>`;
 $("#choices").innerHTML='<button onclick="restart()">重新开始</button>'}
function renderSide(){$("#logList").innerHTML=st.log.map(l=>`<li>${E.hm(D.clock_start,l.at)} ${l.text}${l.key?' <span class="kmark">◆关键</span>':""}</li>`).join("");
 $("#statPre").textContent=JSON.stringify({...st.vals,flags:st.flags,分钟:st.mins},null,1)}
function restart(){st=E.initState(D);render()}
document.querySelectorAll("nav button").forEach(b=>b.onclick=()=>{const p=$("#"+b.dataset.p),h=p.classList.contains("hidden");document.querySelectorAll(".panel").forEach(x=>x.classList.add("hidden"));if(h)p.classList.remove("hidden")});
$("#save").onclick=()=>{localStorage.setItem("cx_save",JSON.stringify(st));$("#msg").textContent="已存档"};
$("#load").onclick=()=>{const s=localStorage.getItem("cx_save");if(s){st=JSON.parse(s);st.bonuses=st.bonuses||[];render();$("#msg").textContent="已读档"}else $("#msg").textContent="没有存档"};
$("#restart").onclick=()=>{restart();$("#msg").textContent="已重开"};
$("#optKey").checked=opt.showKey;$("#optKey").onchange=e=>{opt.showKey=e.target.checked;localStorage.setItem("cx_opt",JSON.stringify(opt));render()};
render();
<!doctype html><html lang="zh"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>残响协议 · 原型</title><link rel="stylesheet" href="style.css"></head><body>
<header id="hdr"><span id="clock">05:00</span><span id="sid"></span>
<nav><button data-p="log">日志</button><button data-p="stats">数值</button><button data-p="menu">菜单</button></nav></header>
<main id="stage"><div id="bg"></div><div id="portrait"></div>
<section id="text"></section><section id="choices"></section></main>
<aside id="log" class="panel hidden"><h3>行动日志</h3><ol id="logList"></ol></aside>
<aside id="stats" class="panel hidden"><h3>数值（调试）</h3><pre id="statPre"></pre></aside>
<aside id="menu" class="panel hidden"><h3>菜单</h3>
<button id="save">存档</button><button id="load">读档</button><button id="restart">重开</button>
<label><input type="checkbox" id="optKey"> 在选项上标出关键抉择</label><p id="msg"></p></aside>
<script src="data.js"></script><script src="engine.js"></script><script src="app.js"></script></body></html>
:root{--bg:#07110d;--fg:#cfe3d8;--dim:#6f8f80;--mira:#3ff0e6;--line:#1f3a2f;--key:#7fd8b0}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.75 system-ui,"PingFang SC","Noto Sans CJK SC",sans-serif;max-width:560px;margin:auto}
#hdr{position:sticky;top:0;z-index:5;display:flex;gap:.6em;align-items:center;padding:.5em .8em;background:#0b1a14ee;border-bottom:1px solid var(--line)}
#clock{color:var(--mira);font-family:monospace;font-size:1.1em}#sid{color:var(--dim);font-size:.75em;flex:1}
button{background:#10261d;color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:.35em .7em;font:inherit;font-size:.85em}
#stage{position:relative}#bg{height:34vh;background:#0e2a1f center/cover no-repeat;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:.8em}
#portrait{position:absolute;right:.6em;top:calc(34vh - 70px);width:84px;height:84px;border-radius:50%;border:2px solid var(--mira);background:#08302c center/cover;box-shadow:0 0 12px #3ff0e655}
#portrait:empty.none{display:none}#text{padding:1em;white-space:pre-wrap}
#choices{padding:0 .8em 2em;display:flex;flex-direction:column;gap:.6em}
.card{display:flex;gap:.7em;align-items:center;text-align:left;padding:.45em;border:1px solid var(--line);background:#0c1d16;border-radius:8px;position:relative}
.thumb{width:120px;height:90px;flex:none;border-radius:4px;background:#123526 center/cover;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:.65em}
.card .t{font-size:.8em;color:var(--dim)}.card.key{border-color:var(--key);box-shadow:inset 0 0 0 1px #7fd8b055}
.card.key::after{content:"◆ 关键";position:absolute;right:.4em;top:.3em;font-size:.65em;color:var(--key)}
.result{border-left:2px solid var(--mira);padding-left:.8em;color:#bfeee9}
.panel{position:fixed;inset:44px 0 0;max-width:560px;margin:auto;background:#07110df5;padding:1em;overflow:auto;z-index:4}.hidden{display:none}
.panel button{margin:.3em}.kmark{color:var(--key);font-size:.75em}
#logList li{margin:.4em 0}h2,h3{color:var(--mira);font-weight:500}
// node test_paths.js → state-deduplicated branch report (also writes test-report.txt)
const fs = require("fs"), path = require("path"), E = require("./engine.js");
const D = JSON.parse(fs.readFileSync(path.join(__dirname, "data.json"), "utf8"));
const SCN = Object.fromEntries(D.scenes.map(s => [s.id, s]));
const out = [], P = s => out.push(s);
let fail = 0;
const MAX_STATES = 200000;
const ends = [], dead = new Set(), refd = new Set([D.scenes[0].id]);
const displayedPortraits = new Set();
const sceneStates = new Map(D.scenes.map(s => [s.id, 0]));
const locks = new Map();
const seen = new Map(), queue = [];
let truncated = false;
let minuteRange = [Infinity, -Infinity];

function sortedObject(obj) {
  return Object.fromEntries(Object.keys(obj || {}).sort().map(k => [k, obj[k]]));
}
function stateKey(st) {
  return JSON.stringify([
    st.scene,
    [...(st.flags || [])].sort(),
    sortedObject(st.vals),
    [...(st.bonuses || [])].sort()
  ]);
}
function enqueue(st, trail) {
  minuteRange[0] = Math.min(minuteRange[0], st.mins);
  minuteRange[1] = Math.max(minuteRange[1], st.mins);
  const key = stateKey(st);
  if (seen.has(key)) return seen.get(key);
  if (seen.size >= MAX_STATES) {
    truncated = true;
    return null;
  }
  const node = { key, st, trail, edges: [], outcome: false };
  seen.set(key, node);
  queue.push(node);
  return node;
}

enqueue(E.initState(D), []);
for (let cursor = 0; cursor < queue.length; cursor++) {
  const node = queue[cursor], { st, trail } = node;
  minuteRange[0] = Math.min(minuteRange[0], st.mins);
  minuteRange[1] = Math.max(minuteRange[1], st.mins);
  const s = SCN[st.scene];
  if (!s) {
    const label = `${trail.at(-1) || "开场"} → next "${st.scene}"（场景不存在）`;
    dead.add(label);
    node.outcome = true;
    ends.push({ st, trail, e: null, unfinished: true, missing: true, nodeKey: node.key });
    continue;
  }
  sceneStates.set(s.id, (sceneStates.get(s.id) || 0) + 1);
  const displayedPortrait = E.resolvePortrait(D, s, st);
  if (displayedPortrait) displayedPortraits.add(displayedPortrait);
  for (const c of s.choices || []) if (c.next) refd.add(c.next);

  if (!(s.choices || []).length) {
    const e = E.ending(D, st);
    node.outcome = true;
    ends.push({ st, trail, e, unfinished: !e, nodeKey: node.key });
    if (!e) dead.add(`${s.id} 无选项且无结局`);
    continue;
  }

  const choices = E.visibleChoices(s, st);
  if (!choices.length) {
    node.outcome = true;
    const item = locks.get(s.id) || { count: 0, flags: [...(st.flags || [])].sort() };
    item.count++;
    locks.set(s.id, item);
    continue;
  }
  for (const c of choices) {
    const next = E.clone(st);
    E.apply(next, c, D);
    const child = enqueue(next, [...trail, c.id]);
    if (child) node.edges.push({ to: child.key, choice: c.id });
  }
}

// Count distinct choice paths on the deduplicated state graph. Parallel choice edges remain separate.
const nodes = [...seen.values()], indegree = new Map(nodes.map(n => [n.key, 0]));
for (const n of nodes) for (const edge of n.edges) indegree.set(edge.to, indegree.get(edge.to) + 1);
const topoQueue = nodes.filter(n => indegree.get(n.key) === 0).map(n => n.key), ways = new Map(nodes.map(n => [n.key, 0n]));
if (topoQueue.length) ways.set(topoQueue[0], 1n);
const topo = [];
for (let cursor = 0; cursor < topoQueue.length; cursor++) {
  const key = topoQueue[cursor], n = seen.get(key);
  topo.push(key);
  for (const edge of n.edges) {
    ways.set(edge.to, ways.get(edge.to) + ways.get(key));
    indegree.set(edge.to, indegree.get(edge.to) - 1);
    if (indegree.get(edge.to) === 0) topoQueue.push(edge.to);
  }
}
const pathCycle = topo.length !== nodes.length;
let pathTotal = pathCycle
  ? BigInt(nodes.filter(n => n.outcome).length)
  : nodes.filter(n => n.outcome).reduce((sum, n) => sum + ways.get(n.key), 0n);
const pathTruncated = pathTotal > BigInt(MAX_STATES);
if (pathTruncated) pathTotal = BigInt(MAX_STATES);
const outcomePaths = new Map(nodes.filter(n => n.outcome).map(n => [n.key, pathCycle ? 1n : ways.get(n.key)]));

P(`数据源: ${(D._sources || []).join(", ")}`);
P(`场景 ${D.scenes.length} · 唯一状态 ${seen.size}${truncated ? "（已截断）" : ""} · 终点路径 ${pathTotal}${pathTruncated || truncated ? "（已截断）" : pathCycle ? "（状态图有环，按终点状态计）" : ""} · endings ${(D.endings || []).length} · bonuses ${(D.bonuses || []).length} · self_endings ${(D.self_endings || []).length}`);

// Duplicate ids
const dup = a => a.filter((x, i) => a.indexOf(x) !== i);
const d1 = dup(D.scenes.map(s => s.id));
const d2 = dup(D.scenes.flatMap(s => (s.choices || []).map(c => c.id)));
if (d1.length || d2.length) P(`\n[重复 id] 场景:${d1} 选项:${d2}`);

P(`\n[死路] ${dead.size}`);
dead.forEach(x => P("  - " + x));
P(`\n[未被引用的场景] ${D.scenes.filter(s => !refd.has(s.id)).map(s => s.id).join(", ") || "无"}`);

// Conditional deadlocks and fallback checks
P(`\n[卡死] ${[...locks.values()].reduce((n, x) => n + x.count, 0)}`);
for (const [id, item] of locks) P(`  - 卡死: ${id} · ${item.count} 次 · 示例 flags=${JSON.stringify(item.flags)}`);
const noFallback = D.scenes.filter(s => (s.choices || []).length && !(s.choices || []).some(c =>
  !Object.prototype.hasOwnProperty.call(c, "when") &&
  !Object.prototype.hasOwnProperty.call(c, "requires") &&
  !Object.prototype.hasOwnProperty.call(c, "hide_if")
));
P(`\n[缺兜底选项] ${noFallback.length}`);
noFallback.forEach(s => P(`  - 缺兜底选项: ${s.id}`));
P(`\n[场景可达状态数 / 卡死次数]`);
for (const s of D.scenes) P(`  - ${s.id}: ${sceneStates.get(s.id) || 0} / ${(locks.get(s.id) || { count: 0 }).count}`);

// Images
const need = new Set();
D.scenes.forEach(s => {
  if (s.bg) need.add(s.bg);
  (s.choices || []).forEach(c => need.add("thumb:" + c.id));
});
(displayedPortraits).forEach(portrait => need.add(portrait));
(D.portrait_overrides || []).forEach(override => {
  if (override.to) need.add(override.to);
});
(D.endings || []).filter(e => !e.same_as).forEach(e => need.add("ending:" + e.id));
const miss = [...need].filter(k => !D.images[k]);
P(`\n[缺失图片] ${miss.length}/${need.size}（可达状态实际显示立绘 ${displayedPortraits.size} 个，另检查所有替换目标）`);
P("  " + miss.join(", "));
P(`  已找到: ${Object.entries(D.images || {}).map(([k, v]) => k + "→" + v).join("; ")}`);

P(`\n[立绘替换] ${ (D.portrait_overrides || []).length } 条`);
(D.portrait_overrides || []).forEach((override, index) => {
  const source = (D._portrait_override_sources || [])[index] || "来源未知";
  P(`  - ${source}: ${JSON.stringify(override.when)} · ${override.from} → ${override.to}`);
});
(D._portrait_override_skipped || []).forEach(source => {
  P(`  - ${source}: 跳过重复项（story 已有相同 from+to）`);
});

// Ending and reachable-state value ranges
function rangesFor(rows) {
  const ranges = {};
  for (const { st } of rows) {
    for (const [k, v] of Object.entries({ ...st.vals, 分钟: st.mins })) {
      ranges[k] = ranges[k] || [Infinity, -Infinity];
      ranges[k][0] = Math.min(ranges[k][0], v);
      ranges[k][1] = Math.max(ranges[k][1], v);
    }
  }
  return ranges;
}
const r = rangesFor(ends);
P(`\n[路径终点数值范围]`);
for (const [k, [a, b]] of Object.entries(r)) P(`  ${k}: ${a} ~ ${b}`);
if (r.分钟) P(`  终点时钟: ${E.hm(D.clock_start, r.分钟[0])} ~ ${E.hm(D.clock_start, r.分钟[1])}`);
if (minuteRange[0] !== Infinity) P(`  全部可达状态分钟范围: ${minuteRange[0]} ~ ${minuteRange[1]}（${E.hm(D.clock_start, minuteRange[0])} ~ ${E.hm(D.clock_start, minuteRange[1])}）`);
const dist = {};
ends.forEach(x => {
  const k = x.missing ? "(next 未写，场景不存在)" : x.unfinished ? "(无结局)" : x.e.id;
  const count = Number(outcomePaths.get(x.nodeKey) || 0n);
  dist[k] = (dist[k] || 0) + count;
});
P(`\n[当前路径结局分布] ${JSON.stringify(dist)}`);

// Find flag references in expression strings and {all}/{any} objects.
function collectConditionFlags(value, found) {
  if (typeof value === "string") {
    for (const m of value.matchAll(/flag:([A-Za-z_][A-Za-z0-9_.=-]*)/g)) found.add(m[1]);
    for (const m of value.matchAll(/\b([A-Za-z_][A-Za-z0-9_.-]*)\s*==\s*([A-Za-z_][A-Za-z0-9_.-]*)/g)) {
      if (!Object.prototype.hasOwnProperty.call(D.values || {}, m[1])) found.add(m[1] + "=" + m[2]);
    }
    for (const m of value.matchAll(/\b([A-Za-z_][A-Za-z0-9_.-]*)\s+in\s*\[([^\]]*)\]/g)) {
      if (!Object.prototype.hasOwnProperty.call(D.values || {}, m[1])) {
        for (const item of m[2].matchAll(/[A-Za-z_][A-Za-z0-9_.-]*/g)) found.add(m[1] + "=" + item[0]);
      }
    }
  } else if (Array.isArray(value)) value.forEach(v => collectConditionFlags(v, found));
  else if (value && typeof value === "object") Object.values(value).forEach(v => collectConditionFlags(v, found));
}
const setF = new Set(D.scenes.flatMap(s => (s.choices || []).flatMap(c => c.flags_set || [])));
const refF = new Map();
const portraitRefF = new Map();
const addRefs = (source, condition) => {
  const found = new Set();
  collectConditionFlags(condition, found);
  for (const flag of found) {
    if (!refF.has(flag)) refF.set(flag, new Set());
    refF.get(flag).add(source);
  }
};
D.scenes.forEach(s => (s.choices || []).forEach(c => {
  for (const field of ["when", "requires", "hide_if"]) {
    if (!Object.prototype.hasOwnProperty.call(c, field)) continue;
    if (field === "when") addRefs(`${s.id}/${c.id}.when`, c.when);
    else {
      const list = Array.isArray(c[field]) ? c[field] : [c[field]];
      for (const flag of list) if (typeof flag === "string") {
        if (!refF.has(flag)) refF.set(flag, new Set());
        refF.get(flag).add(`${s.id}/${c.id}.${field}`);
      }
    }
  }
}));
(D.endings || []).forEach(e => { addRefs(e.id, e.when); addRefs(e.id + ".variant", e.variant); });
(D.bonuses || []).forEach(b => addRefs(b.id, b.when));
(D.self_endings || []).forEach(s => addRefs(s.id, s.when));
(D.portrait_overrides || []).forEach((override, index) => {
  const source = (D._portrait_override_sources || [])[index] || "来源未知";
  const found = new Set();
  collectConditionFlags(override.when, found);
  for (const flag of found) {
    if (!portraitRefF.has(flag)) portraitRefF.set(flag, new Set());
    portraitRefF.get(flag).add(`portrait_overrides[${index}] (${source})`);
  }
});
(D.portrait_overrides || []).forEach((override, index) => {
  const source = (D._portrait_override_sources || [])[index] || "来源未知";
  addRefs(`portrait_overrides[${index}] (${source})`, override.when);
});
const unset = [...refF].filter(([flag]) => !setF.has(flag));
const portraitUnset = [...portraitRefF].filter(([flag]) => !setF.has(flag));
P(`\n[立绘替换条件引用但无人设置的 flag] ${portraitUnset.length}`);
portraitUnset.forEach(([flag, sources]) => P(`  - ${flag} ← ${[...sources].join(", ")}`));
P(`\n[条件引用但数据中无人设置的 flag] ${unset.length}/${refF.size}`);
unset.forEach(([flag, sources]) => P(`  - ${flag} ← ${[...sources].join(", ")}`));

// Choice balance checks
const chapterOf = id => (String(id).match(/^c\d+/) || ["全数据"])[0];
const keyCounts = new Map();
const largeEffects = [];
for (const s of D.scenes) for (const c of s.choices || []) {
