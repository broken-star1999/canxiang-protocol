   417	    archive.collection.endings = archive.collection.endings || {};
   418	    archive.collection.endings[activeChapter.id] = archive.collection.endings[activeChapter.id] || [];
   419	    if (run.ending && !archive.collection.endings[activeChapter.id].includes(run.ending)) archive.collection.endings[activeChapter.id].push(run.ending);
   420	    archive.collection.selfEndings = archive.collection.selfEndings || [];
   421	    if (run.selfEnding && !archive.collection.selfEndings.includes(run.selfEnding)) archive.collection.selfEndings.push(run.selfEnding);
   422	    archive.collection.echoesSeen = [...new Set([...(archive.collection.echoesSeen || []), ...Object.keys(exportedEchoes)])];
   423	    replayNeedsDecision = !!(archive.mainline && archive.mainline[activeChapter.id]);
   424	    if (!replayNeedsDecision) {
   425	      E.completeRun(archive, activeRunId, null, chapterOrder);
   426	      saveArchive();
   427	      showReview(run);
   428	    } else {
   429	      archive.inProgress = { run: activeRunId, scene: null, state: E.clone(state) };
   430	      saveArchive();
   431	      showCompletionChoice(run);
   432	    }
   433	  }
   434	  function showCompletionChoice(run) {
   435	    showView("reviewView");
   436	    const area = $("#reviewContent");
   437	    area.replaceChildren();
   438	    area.appendChild(node("h2", "本章小结局 · " + ((findEnding(run.chapter, run.ending) || {}).title || "已完成")));
   439	    const ending = findEnding(run.chapter, run.ending);
   440	    if (ending && ending.text) area.appendChild(node("p", ending.text));

