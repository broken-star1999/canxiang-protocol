+def latest_named_version(filename):
+    """Resolve the highest _vN sibling for an indexed YAML path."""
+    folder, base = os.path.split(filename)
+    match = re.match(r"^(.*?)_v(\d+)(\.ya?ml)$", base, re.IGNORECASE)
