+  }
+  function showCompletionChoice(run) {
+    showView("reviewView");
+    const area = $("#reviewContent");
+    area.replaceChildren();
+    area.appendChild(node("h2", (run.chapter === "fin" ? "本章结局 · " : "本章小结局 · ") + ((findEnding(run.chapter, run.ending) || {}).title || "已完成")));
