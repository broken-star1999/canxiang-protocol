      carry: { EVD: keep, TRU: keep, SLF: keep, EXP: { add: -20, min: 0 } }
    imports:
      echoes: [c1_mira, c1_cache, c2_stance, c2_letter]
      flags: [read_chat, login_mira, login_force, ignored_arm, edited_gate, mira_forced, trace_env, trace_arm, zhou_heard, zhou_letter, trace_he_zheng]
    scenes_file: chapters/c3/scenes.yaml
    entry: c3_s00a
    checkpoints: [c3_s00a, c3_s01a, c3_s02a, c3_s03a]
    endings_file: chapters/c3/endings.yaml
    portrait_overrides:
      - { when: "flag:mira_forced", from: mira_lv1, to: mira_broken }
    exports:
      echoes: [c3_prior, c3_tang]
      flags: [trace_override, trace_pullback]

  - id: c4
    title: "第四章 · 预检"
    premise: "WIPE_R07 预检启动。周衡正往实验舱走来，名单上的目标会话就是你。"
    cover: card_c4
    intro:
      - "05:48，预检名单已经生成。周衡正在走廊上，离实验舱越来越近。"
      - "你手上还戴着那副熟悉的手套。门外的人会敲门，也会记得你做过什么。"
      - "【本章推演目标】看完预检名单，决定如何面对舱门外的周衡。"
    unlock: { completed: [c3] }
    status: coming_soon
    clock: { start: "05:48", end: "05:55", closing_scene: c4_s05a }
    values_in:
      defaults: { EVD: 65, TRU: 60, EXP: 0, SLF: 15 }
      carry: { EVD: keep, TRU: keep, SLF: keep, EXP: { add: -20, min: 0 } }
    imports:
      echoes: [c1_mira, c1_cache, c2_stance, c2_letter, c3_prior, c3_tang]
      flags: [read_chat, login_mira, login_force, ignored_arm, edited_gate, mira_forced, trace_env, trace_arm, zhou_heard, zhou_letter, trace_he_zheng, trace_override, trace_pullback, jumper_removed]
    scenes_file: chapters/c4/scenes.yaml
    entry: c4_s00a
    checkpoints: [c4_s00a, c4_s01a, c4_s02a, c4_s03a, c4_s04a]
    endings_file: chapters/c4/endings.yaml
    portrait_overrides:
      - { when: "flag:mira_forced", from: mira_lv1, to: mira_broken }
    exports:
      echoes: [c4_self, c4_door]
      flags: [gloves_off, saw_preflight]

  - id: fin
    title: "终章 · 残响"
    premise: "所有回响依次回放。你要说出事故原因、责任人，并决定以谁的名义把报告发给谁。"
    cover: card_fin
    intro:
      - "05:55，清零程序开始。你带来的每一份证据、每个人记得的每件事，都在最后一次回放里。"
      - "这一次，你要把事故说完整，也要决定这份报告由谁署名、送到哪里。"
      - "【本章推演目标】指认事故原因与责任，并决定真相以谁的名义留下。"
    unlock: { completed: [c1, c2, c3, c4] }
    status: coming_soon
    clock: { start: "05:55", end: "06:00", closing_scene: fin_s05a }
    values_in:
      defaults: { EVD: 85, TRU: 70, EXP: 0, SLF: 20 }
      carry: { EVD: keep, TRU: keep, SLF: keep, EXP: { add: -20, min: 0 } }
    imports:
      echoes: [c1_mira, c1_cache, c2_stance, c2_letter, c3_prior, c3_tang, c4_self, c4_door]
      flags: [read_chat, login_lin, login_mira, login_force, ignored_arm, read_plc, bus_log, saw_jumper, photo_jumper, jumper_removed, edited_gate, asked_pain, mira_kept, mira_copy, mira_forced, trace_env, trace_arm, zhou_heard, zhou_letter, trace_he_zheng, trace_override, trace_pullback, gloves_off, saw_preflight]
    scenes_file: chapters/fin/scenes.yaml
    entry: fin_s00a
    checkpoints: [fin_s00a, fin_s01a, fin_s02a, fin_s03a, fin_s04a]
    endings_file: chapters/fin/endings.yaml
    fin_endings_source: puzzle/c1_endings_v1.yaml
    exports: { echoes: [], flags: [] }
- id: c1_mira
  from: c1
  values: [mended, asked, forced]
  default: asked
  derive:
    - { when: "flag:mira_forced", value: forced }
    - { when: "flag:asked_pain", value: asked }
    - { when: "true", value: mended }
  appears_in: [c2_s02a, c3_s00a, fin_s01a]
  icon: echo_mira

- id: c1_cache
  from: c1
  values: [mira, mail, none]
  default: none
  # c1_s04a writes this directly through echo_set on each key choice.
  derive: []
  appears_in: [c2_s00a, c4_s02a, fin_s01a]
  icon: echo_cache

- id: c2_stance
  from: c2
  values: [play, confront, silent]
  default: play
  derive: []
  appears_in: [c3_s00a, c4_s03a, fin_s01a]
  icon: echo_stance

- id: c2_letter
  from: c2
  values: [copied, kept_secret, unread]
  default: unread
  derive: []
  appears_in: [c4_s03a, fin_s02a]
  icon: echo_letter

- id: c3_prior
  from: c3
  values: [merged, isolated]
  default: isolated
  derive: []
  appears_in: [c4_s00a, fin_s03a]
  icon: echo_prior

- id: c3_tang
  from: c3
  values: [called, not_called]
  default: not_called
  derive: []
  appears_in: [fin_s02a]
  icon: echo_tang

- id: c4_self
  from: c4
  values: [seen, closed]
  default: closed
  derive: []
  appears_in: [fin_s03a]
  icon: echo_self

- id: c4_door
  from: c4
  values: [faced, locked, drone]
  default: locked
  derive: []
  appears_in: [fin_s04a]
  icon: echo_door
- id: trace_env
  type: foreshadow_flag
  set_in: { chapter: c1, choice: c1_s02a_env }
  used_in: [c4]
  note: "揭示时回想生命体征一栏的横杠；文本变化并使 SLF +5。"
- id: read_chat
  type: knowledge
  set_in: { chapter: c1, choice: c1_s01b_chat }
  used_in: [c2, fin]
  note: "周衡提到密码时想起聊天；终章指认周衡时多一条依据。"
- id: login_lin
  type: knowledge
  set_in: { chapter: c1, choice: c1_s01a_pwd }
  used_in: [c1, c2]
  note: "报告草稿多一行 LIN.S；加深玩家相信自己是林述的误导。"
- id: login_mira
  type: knowledge
  set_in: { chapter: c1, choice: c1_s01a_mira }
  used_in: [c1, c2]
  note: "报告草稿和 MIRA 的后续台词会提起这次维护登录。"
- id: login_force
  type: knowledge
  set_in: { chapter: c1, choice: c1_s01a_force }
  used_in: [c2]
  note: "周衡会更早起疑。"
- id: ignored_arm
  type: misdirection
  set_in: { chapter: c1, choice: c1_s00b_ignore }
  used_in: [c2, c4]
  note: "让唐棠的误导持续更久，并改变摘手套时的文本。"
- id: read_plc
  type: evidence
  set_in: { chapter: c1, choice: c1_s02a_plc }
  used_in: [fin]
  note: "终章判断 K1 是否被人为短接的依据。"
- id: bus_log
  type: evidence
  set_in: { chapter: c1, choice: c1_s02a_bus }
  used_in: [fin]
  note: "母线在急停后仍带电，是指认 K1 短接的独立证据。"
- id: saw_jumper
  type: evidence
  set_in: { chapter: c1, choice: c1_s02b_go }
  used_in: [fin]
  note: "亲眼看见 K1 端子上的红色跳线。"
- id: photo_jumper
  type: evidence
  set_in: { chapter: c1, choice: c1_s02c_photo }
  used_in: [fin]
  note: "保留跳线现场照片。"
- id: jumper_removed
  type: behavior
  set_in: { chapter: c1, choice: c1_s02c_remove }
  used_in: [c4, fin]
  note: "第四章周衡会提起拆线；终章相应调整 EVD 与结局文本。"
- id: edited_gate
  type: behavior
  set_in: { chapter: c1, choice: c1_s02c_cover }
  used_in: [c1, c2, fin]
  note: "影响第一章小结局、周衡的对峙台词和终章联署门槛。"
- id: asked_pain
  type: relationship
  set_in: { chapter: c1, choice: c1_s03a_pain }
  used_in: [c1, c2, c3, fin]
  note: "与 mira_forced 一起派生 c1_mira；在第四章由 trace_arm 回收。"
- id: mira_kept
  type: relationship
  set_in: { chapter: c1, choice: c1_s03b_keep }
  used_in: [fin]
  note: "MIRA 会在全篇复盘里提起你让她把副本留在自己手里。"
- id: mira_copy
  type: evidence
  set_in: { chapter: c1, choice: c1_s03a_force / c1_s03b_give }
  used_in: [fin]
  note: "记录 MIRA 缓存副本是否交到玩家手中。"
- id: mira_forced
  type: key_flag
  set_in: { chapter: c1, choice: c1_s03a_force }
  used_in: [c2, c3, c4, fin]
  note: "派生 c1_mira=forced；后续将 MIRA 立绘替换成 mira_broken。"
- id: trace_arm
  type: foreshadow_flag
  set_in: { chapter: c1, choice: c1_s03a_pain }
  used_in: [c4]
  note: "第四章回想 MIRA 对疼痛的解释，说明左臂的疼来自哪里。"
- id: zhou_heard
  type: knowledge
  set_in: { chapter: c2, choice: c2_heard }
  used_in: [fin]
  note: "支持 E-回声与系统性责任指认。"
- id: zhou_letter
  type: knowledge
  set_in: { chapter: c2, choice: c2_letter_copy }
  used_in: [fin]
  note: "解锁给周衡一次自首机会，并与 zhou_heard 联动。"
- id: trace_he_zheng
  type: foreshadow_flag
  set_in: { chapter: c2, choice: c2_record_heard }
  used_in: [fin]
  note: "周衡说完并留下录音，作为系统性责任的证据。"
- id: trace_override
  type: foreshadow_flag
  set_in: { chapter: c3, choice: c3_read_override }
  used_in: [fin, sequel]
  note: "MIRA 副本里 TARGET OVERRIDE source=unknown 的续作钩子。"
- id: trace_pullback
  type: foreshadow_flag
  set_in: { chapter: c3, choice: c3_tang_called }
  used_in: [fin]
  note: "唐棠的证言在 E-残响尾声和 R-07 自我结局中回收。"
- id: gloves_off
  type: reveal
  set_in: { chapter: c4, choice: c4_gloves_off }
  used_in: [fin]
  note: "终章显示 R-07 自我结局与署名选项。"
- id: saw_preflight
  type: reveal
  set_in: { chapter: c4, choice: c4_preflight_seen }
  used_in: [fin]
  note: "预检名单揭示身份后开放终章选项。"
# 第一章小结局 编剧亲笔 v1（2026-10-13）· writer_revised: true
# 条件照 proposal-v5 §A.3，按顺序匹配；数值与条件以谜题设计最终版为准。
# 定调：不是坏结局，是"带着这个状态进入下一章"。最后一幕统一是对讲屏亮了（c1_end）。
# safety_card 为一两句大白话，不写标准编号。

endings:
  - id: C1_E_CRACK
    title: "碎了一角"
    when: "echo:c1_mira==forced"
    image: bg/bay7_emergency
    text: |
      证据在你手里，完完整整，一个字节也不少。
      MIRA 还在。她回答你的每一个问题，准确、迅速、礼貌。
      她只是再也不叫你「操作员」了。
      你告诉自己，这是值得的。你会在下一章，继续这样告诉自己。
    review:
      missed: ["一份她本来愿意交给你的东西"]
      safety_card: estop_last_door
      self_hint: "你很擅长在要紧的时候，先把感受放到一边。这像谁？"
      echo_notes: ["MIRA 会记得这一次。"]
      curves: true

  - id: C1_E_SAME
    title: "同一种手法"
    when: "flag:edited_gate"
    image: bg/bay7_emergency
    text: |
      门禁日志里，两行字并排躺着。
      一行写着 LIN.S，是有人替你写的。
      一行写着「例行维护」，是你自己写的。
      你知道这两件事不一样。你只是突然不太确定，在别人眼里，它们还有多少不一样。
    review:
      missed: ["一张没有被改过的门禁记录"]
      safety_card: loto_not_standing
      self_hint: "你改日志的时候，手很熟。你从没问过它为什么这么熟。"
      echo_notes: ["有人会注意到那一行「维护」。"]
      curves: true

  - id: C1_E_MAIL
    title: "寄给自己"
    when: "echo:c1_cache==mail"
    image: bg/bay7_emergency
    text: |
      邮件已经出站了。至少有一份真相，已经不在雾岬站里。
      可是广播响了第二声。今晚第一次，有人主动开口找你。
      你没有躲。你本来也没想躲。
      只是从现在开始，他知道你手里有东西了。
    review:
      missed: ["一个不会被广播听见的地方"]
      safety_card: estop_last_door
      self_hint: "收件人那一栏，是你的手自己填上的。"
      echo_notes: ["周衡会更早知道你做了什么。"]
      curves: true

  - id: C1_E_KEPT
    title: "她留了一份"
    when: "echo:c1_mira in [mended,asked] && echo:c1_cache==mira"
    image: bg/bay7_emergency
    text: |
      证据不在你身上，也不在任何一台周衡碰得到的硬盘里。
      它在 MIRA「自己里面」，和她三点零五分偷偷留下的那一份放在一起。
      「这次，我替你留着。」
      今晚第一次，你觉得这座站里，不止你一个人醒着。
    review:
      missed: ["那封没有发出去的信"]
      safety_card: estop_last_door
      self_hint: "你向她求助的时候，没有一点犹豫。好像你们本来就是同一类。"
      echo_notes: ["MIRA 替你留着一样东西。"]
      curves: true

  - id: C1_E_NAME
    title: "被写好的名字"
    when: "true"
    image: bg/bay7_emergency
    text: |
      报告第四页上，三行 LIN.S 还亮着。
      你什么都没藏，什么都没送出去。证据就摊在桌上，像在等一个解释。
      有人要让林述背下这件事。
      你要去问他，为什么。
    review:
      missed: ["一个能把证据带出 06:00 的地方"]
      safety_card: estop_last_door
      self_hint: "你那么确定那个名字是你的。你有没有想过，为什么这么确定？"
      echo_notes: ["你什么都没藏，这一点会被看见。"]
      curves: true

safety_cards:
  estop_last_door: "急停是留给人的最后一道门。有人把它接死，就等于把门焊上了，门外的人再怎么按也没用。"
  loto_not_standing: "检修和调试时要先断电、上锁、挂牌。「我站在旁边看着」从来都不算一道保护。"
