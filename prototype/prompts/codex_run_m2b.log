+    const targetIndex = chapterOrder.indexOf(target.id);
+    let values = E.carryValues({}, chapters[0] || target);
+    const allEchoes = {}, allFlags = new Set();
+    for (let index = 0; index < targetIndex; index++) {
+      const previousChapter = chapters[index];
