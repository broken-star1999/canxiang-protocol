+  }
+  function encodeArchive() {
+    const json = JSON.stringify(archive);
+    return btoa(unescape(encodeURIComponent(json)));
+  }
+  function exportCode() {
+    const code = encodeArchive();
+    $("#saveCode").value = code;
+    $("#saveCodeDialog").classList.remove("hidden");
+    $("#saveCode").focus();
