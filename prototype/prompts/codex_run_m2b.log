+      if (kind === "VP8X") return { width: 1 + data.readUIntLE(24, 3), height: 1 + data.readUIntLE(27, 3) };
+      if (kind === "VP8L") {
+        const b1 = data[21], b2 = data[22], b3 = data[23], b4 = data[24];
