+  }
+  function showReview(run, staleChapters) {
+    if (!run) return;
+    const chapter = chapterById[run.chapter];
+    const ending = findEnding(run.chapter, run.ending);
+    const details = run.reviewData || ending || {};
+    showView("reviewView");
+    const area = $("#reviewContent");
+    area.replaceChildren();
+    area.appendChild(node("p", chapter ? chapter.title : run.chapter, "eyebrow"));
+    area.appendChild(node("h2", (run.chapter === "fin" ? "结局 · " : "小结局 · ") + ((ending && ending.title) || run.ending || "本章结束")));
