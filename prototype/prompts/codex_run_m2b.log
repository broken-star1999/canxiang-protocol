+    if (run.chapter === "fin" && run.selfEnding) area.appendChild(node("p", "自我结局：" + run.selfEnding));
+    area.appendChild(node("p", `用时 ${state && activeRunId === run.id ? state.mins : (run.curve || []).at(-1)?.t || 0} 分钟。`));
+    if (staleChapters && staleChapters.length) area.appendChild(node("p", "后续主线已标记回响已改变：" + staleChapters.join("、"), "notice"));
+    const actions = $("#reviewActions");
