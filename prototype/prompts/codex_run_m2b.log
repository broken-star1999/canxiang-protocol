   199	        pair = (override.get("from"), override.get("to"))
   200	        if pair in story_override_pairs:
   201	            D["_portrait_override_skipped"].append(rel_root(prototype_overrides))
   202	            continue
   203	        D["portrait_overrides"].append(override)
   204	        D["_portrait_override_sources"].append(rel_root(prototype_overrides))
   205	    D["_sources"].append(rel_root(prototype_overrides))
   206	
   207	# Scan only usable raster assets and SVG icons. Generated draft directories are ignored.
   208	ART_OUT = os.path.join(ROOT, "art", "out")
   209	raster_files, icon_files = [], []
   210	if os.path.isdir(ART_OUT):
   211	    for directory, subdirs, filenames in os.walk(ART_OUT):
   212	        subdirs[:] = [name for name in subdirs if name != "_draft_genimage"]
   213	        for filename in filenames:
   214	            full = os.path.join(directory, filename)
   215	            lower = filename.lower()
   216	            if lower.endswith((".webp", ".png")):
   217	                raster_files.append(full)
   218	            elif os.path.basename(directory) == "icons" and lower.endswith(".svg"):
   219	                icon_files.append(full)
   220	
   221	def image_choice(stems, files=raster_files):
   222	    candidates = []
   223	    for stem_index, stem in enumerate(stems):
   224	        if not stem:
   225	            continue
   226	        matcher = re.compile(r"^" + re.escape(str(stem)) + r"_v(\d+)\.(webp|png)$", re.IGNORECASE)
   227	        for filename in files:
   228	            match = matcher.match(os.path.basename(filename))
   229	            if match:
   230	                candidates.append((int(match.group(1)), match.group(2).lower() == "webp", -stem_index, filename))
   231	        exact = os.path.basename(str(stem))
   232	        for filename in files:
   233	            if os.path.basename(filename).casefold() == exact.casefold():
   234	                candidates.append((0, filename.lower().endswith(".webp"), -stem_index, filename))
   235	    if not candidates:
   236	        return None
   237	    return max(candidates, key=lambda row: (row[0], row[1], row[2], row[3]))[3]
   238	
   239	def asset_path(filename):
   240	    return os.path.relpath(filename, HERE).replace(os.sep, "/")
