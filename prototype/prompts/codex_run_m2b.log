const missingTrueFlags = neededTrueFlags.filter(f => !setF.has(f));
const ready = !!trueEnding && missingTrueFlags.length === 0;
P(`\n[真结局用例 E_ECHO_TRUE] ${ready ? "启用" : "SKIP；缺少 flags: " + (missingTrueFlags.join(", ") || "E_ECHO_TRUE 结局定义")}`);
