   358	      choices.appendChild(button("查看本章复盘", settleChapter, "primary"));
   359	      saveProgress();
   360	      return;
   361	    }
   362	    for (const choice of available) {
   363	      const card = button("", () => choose(choice), "choice-card" + (choice.key && options.showKey ? " key-choice" : ""));
   364	      const thumb = node("span", "", "choice-thumb");
   365	      setImage(thumb, "thumb:" + choice.id, "图");
   366	      const body = node("span", undefined, "choice-body");
   367	      body.appendChild(node("strong", choice.label));
   368	      body.appendChild(node("small", `+${Number(choice.time || 0)} 分钟`));
   369	      card.append(thumb, body);
   370	      choices.appendChild(card);
   371	    }
   372	    saveProgress();
   373	  }
   374	  function choose(choice) {
   375	    if (awaitingResult) return;
   376	    const sourceScene = state.scene;
   377	    choice.scene = sourceScene;
   378	    E.apply(state, choice, activeChapter);
   379	    maybeForceClosing(sourceScene);
   380	    saveProgress();
   381	    $("#sceneText").textContent = choice.result || "";
   382	    $("#sceneBg").textContent = "";
   383	    const list = $("#choiceList");
   384	    list.replaceChildren(button("继续 ▸", () => {
   385	      awaitingResult = false;
   386	      const current = scenesByChapter[activeChapter.id][state.scene];
   387	      if (current && !(current.choices || []).length) {
   388	        renderGame();
   389	        return;
   390	      }
   391	      renderGame();
   392	    }, "primary"));
   393	    awaitingResult = true;
   394	    $("#clock").textContent = E.hm(activeChapter.clock_start, state.mins);
   395	    window.scrollTo(0, 0);
   396	  }
   397	  function settleChapter() {
   398	    if (!activeRunId || !activeChapter || !state) return;
   399	    const run = archive.runs[activeRunId];
   400	    if (run.finishedAt) return showReview(run);
   401	    E.deriveEchoes(activeChapter, state);
   402	    activeEnding = E.ending(activeChapter, state, { includeSelf: activeChapter.id === "fin" });
   403	    const exports = activeChapter.exports || {};
   404	    const exportedEchoes = {};
   405	    for (const echoId of exports.echoes || []) if (ownValue(state.echoes, echoId)) exportedEchoes[echoId] = state.echoes[echoId];
   406	    run.finishedAt = new Date().toISOString();
   407	    run.valuesOut = E.clone(state.vals);
