+    Object.fromEntries((chapter.scenes || []).map(scene => [scene.id, scene]))]));
+  const devMode = new URLSearchParams(location.search).get("dev") === "1";
+  const STORE_KEY = "echo-protocol:v3:archive";
+
+  let archive = E.newArchive();
