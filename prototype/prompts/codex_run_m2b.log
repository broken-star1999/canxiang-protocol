+    state.curve = state.curve || [];
+    replayNeedsDecision = !!(archive.mainline && archive.mainline[run.chapter]);
+    awaitingResult = false;
+    if (run.finishedAt) {
+      if (replayNeedsDecision && !run.inMainline) showCompletionChoice(run);
+      else showReview(run);
+      return;
+    }
