+    const exports = activeChapter.exports || {};
+    const exportedEchoes = {};
+    for (const echoId of exports.echoes || []) if (ownValue(state.echoes, echoId)) exportedEchoes[echoId] = state.echoes[echoId];
+    run.finishedAt = new Date().toISOString();
