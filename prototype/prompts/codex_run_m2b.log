+    awaitingResult = true;
+    $("#clock").textContent = E.hm(activeChapter.clock_start, state.mins);
+    window.scrollTo(0, 0);
+  }
+  function settleChapter() {
+    if (!activeRunId || !activeChapter || !state) return;
