+    const table = node("table", undefined, "curve-table");
+    const head = node("tr");
+    for (const key of ["时间", "EVD", "TRU", "EXP", "SLF"]) head.appendChild(node("th", key));
+    table.appendChild(head);
+    for (const row of curve) {
+      const tr = node("tr");
+      tr.appendChild(node("td", row.t));
+      for (const key of ["EVD", "TRU", "EXP", "SLF"]) tr.appendChild(node("td", row[key] === undefined ? "—" : row[key]));
+      table.appendChild(tr);
+    }
+    parent.appendChild(table);
+  }
+  function showArchive() {
+    showView("archiveView");
+    renderCollection();
+    renderRunLog();
+    renderEchoArchive();
+    renderReviewLinks();
+  }
+  function renderCollection() {
+    const root = $("#collectionRows");
+    root.replaceChildren();
+    for (const chapter of chapters) {
+      const section = node("section", undefined, "collection-row");
+      section.appendChild(node("h3", chapter.title));
+      const grid = node("div", undefined, chapter.id === "fin" ? "fin-matrix" : "ending-grid");
+      const possible = chapter.endings || [];
