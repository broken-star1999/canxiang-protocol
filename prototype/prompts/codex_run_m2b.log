+    $("#logList").replaceChildren();
+    for (const item of state.log || []) {
+      const li = node("li");
+      const time = node("span", E.hm(activeChapter.clock_start, item.at), "log-time");
+      li.append(time, document.createTextNode(" " + item.text));
