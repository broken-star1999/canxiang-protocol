+  try {
+    const data = fs.readFileSync(filename);
+    if (data.length > 24 && data.subarray(0, 8).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]))) {
+      return { width: data.readUInt32BE(16), height: data.readUInt32BE(20) };
