+
+          「你可以留一份。」她说。
+
+          副本进入本地证据区，来源标注为 MIRA 自愿交付。声纹没有再掉落。
+        log: "MIRA 自愿交出了自己保存的副本。"
+        next: c1_s04a
+      - id: c1_s03b_keep
+        label: "你自己留着，那是你的"
+        key: false
+        when: "TRU >= 50"
+        thumb: c1_s03b_keep
+        effects: { TRU: +15 }
+        time: 1
+        flags_set: [mira_kept]
+        result: |
