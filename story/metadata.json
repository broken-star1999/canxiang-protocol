  "ending_causes": [
    {
      "when": {
        "flag": "forcedReset",
        "value": true
      },
      "text": "新的事故触发载体隔离，备份被作为证物扣留，未被授权恢复。"
    },
    {
      "when": {
        "not": {
          "evidence": "copy"
        }
      },
      "text": "没有保住第一章的原始副本，后续索引不能代替它。"
    },
    {
      "when": {
        "flag": "coverDeal",
        "value": true
      },
      "text": "你接受了内部结案，外发与定责被留在项目权限里。"
    },
    {
      "when": {
        "not": {
          "flag": "linConsent",
          "value": true
        }
      },
      "text": "没有取得林述本人同意，不能用她的署名填补见证。"
    },
    {
      "when": {
        "not": {
          "all": [
            {
              "flag": "outsideReady",
              "value": true
            },
            {
              "not": {
                "flag": "impersonated",
                "value": true
              }
            }
          ]
        }
      },
      "text": "没有一份核验通过的站外独立会话见证。"
    },
    {
      "when": {
        "not": {
          "flag": "selfProtected",
          "value": true
        }
      },
      "text": "你把空间留给证据，今天的个人连续性没有备份。"
    },
    {
      "when": {
        "flag": "bodyDamaged",
        "value": true
      },
      "text": "未处理的左臂损伤在机械救援时扩大，载体不能按时完成复核。"
    },
    {
      "when": {
        "flag": "miraContainer",
        "value": true
      },
      "text": "你启用了以MIRA近期记忆回滚换取外发的方案。"
    },
    {
      "when": {
        "flag": "zhouLost",
        "value": true
      },
      "text": "等待期间周衡重伤，补充证词与延期签字无法取得。"
    },
    {
      "when": {
        "flag": "threatened",
        "value": true
      },
      "text": "对名单的威胁关闭了周衡的材料与授权通道。"
    },
    {
      "when": {
        "flag": "forceRepeat",
        "value": true
      },
      "text": "强制复位重复了依赖故障时钟的执行逻辑。"
    },
    {
      "when": {
        "all": [
          {
            "evidence": "stop"
          },
          {
            "evidence": "patch"
          },
          {
            "evidence": "bus"
          },
          {
            "any": [
              {
                "evidence": "copy"
              },
              {
                "all": [
                  {
                    "evidence": "letter"
                  },
                  {
                    "evidence": "witness"
                  }
                ]
              }
            ]
          }
        ]
      },
      "text": "原件与补充记录能够相互核对，没有把摘要当作证据。"
    },
    {
      "when": {
        "all": [
          {
            "flag": "outsideReady",
            "value": true
          },
          {
            "not": {
              "flag": "impersonated",
              "value": true
            }
          }
        ]
      },
      "text": "站外接收方知道真实身份，独立见证通过了核验。"
    },
    {
      "when": {
        "all": [
          {
            "flag": "independent",
            "value": true
          },
          {
            "flag": "selfProtected",
            "value": true
          }
        ]
      },
      "text": "你保住了今天的连续性，也明确了与林述不同的意愿。"
    },
    {
      "when": {
        "flag": "miraAutonomy",
        "value": true
      },
      "text": "MIRA保有自主调度权限，没有被当作默认服从的容器。"
    }
  ],
