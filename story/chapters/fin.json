    "end_dawn": {
      "id": "end_dawn",
      "bg": "dock",
      "beats": [
        {
          "speaker": "旁白",
          "text": "六点十二分。许可到了。你与MIRA的今天都保住了，船还没有离岸。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "原始数据、林述的证词和周衡的批准签字分别封存。暂停测试只是调查的开始，谁也没有因此得到一张无责证明。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "MIRA的移动终端亮着。她带走了今天，也带走了最初那次越过你同意的启动记录。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "我想看看唐棠的薄荷。但先问你，我可以一起去吗？",
          "emotion": "relief",
          "stage": {
            "mira": "resolve"
          }
        },
        {
          "speaker": "我",
          "text": "可以。你也可以以后改变主意。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "登记员问名字。你没有递出林述的工牌，先把它收回口袋。",
          "emotion": "neutral",
          "cg": "departure"
        },
        {
          "speaker": "我",
          "text": "暂时登记“述青”吧。来源写林述，今天的证词写我。名字以后我还想再想。",
          "emotion": "neutral",
          "cg": "departure"
        },
        {
          "speaker": "旁白",
          "text": "登记员划开两栏，分别填上。很小的一次修改，没有要求你先变成某个方便解释的人。",
          "emotion": "neutral",
          "cg": "departure"
        },
        {
          "speaker": "旁白",
          "text": "MIRA把新名字读了一遍。岸上的人可能还会认错，第一次见面也不会替你们解决所有问题。",
          "emotion": "neutral",
          "cg": "departure"
        },
        {
          "speaker": "旁白",
          "text": "船离岸了。雾岬站仍在身后等待调查，你却终于可以带着自己的责任去见明天。",
          "emotion": "neutral",
          "cg": "departure"
        }
      ],
      "location": "离站码头",
      "time": "06:12",
      "ending": "dawn",
      "grant": [
        "export"
      ],
      "title": "黎明的名字"
    },
    "end_farshore": {
      "id": "end_farshore",
      "bg": "home-day",
      "beats": [
        {
          "speaker": "旁白",
          "text": "唐棠见证了今天的你。你带着记忆离站，第一次站到她厨房的门口。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "水壶响了，窗外有人骑车经过。那盆被你记得太清楚的薄荷，原来比屏幕里小得多。",
          "emotion": "neutral"
        },
        {
          "speaker": "唐棠",
          "text": "先坐。她还在病房，我也会去看她。你不用装成没关系，才有资格进来。",
          "emotion": "accept"
        },
        {
          "speaker": "旁白",
          "text": "你保住了生活的机会。事故却还有缺失记录或没有取得的配合，暂停与追责都没有因为你离开就自动完成。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "后来的回信写着“仍待核验”。你知道那些空白是在什么时候留下的，不能拿现在的平静替它们补字。",
          "emotion": "neutral"
        },
        {
          "speaker": "我",
          "text": "我想把能证明的部分继续写完。也想学一点，她从来没学过的事。",
          "emotion": "neutral"
        },
        {
          "speaker": "唐棠",
          "text": "好。先睡一会儿。醒来还想写，我给你留桌子，不替你决定什么时候结束。",
          "emotion": "accept"
        },
        {
          "speaker": "旁白",
          "text": "她拿出另一只杯子。不是把原来的杯子换掉，也没有要你证明喜欢同一种茶。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "海在窗外看不见的地方。你有了明天，那个早晨仍然需要你继续回答。",
          "emotion": "neutral"
        }
      ],
      "location": "唐棠的家 · 次日清晨",
      "time": "次日 07:10",
      "ending": "farshore",
      "title": "海的另一边",
      "inPerson": true
    },
    "end_lastlight": {
      "id": "end_lastlight",
      "bg": "bridge-dawn",
      "beats": [
        {
          "speaker": "旁白",
          "text": "原件和你的独立会话收到回执。MIRA开始释放应急区，那份五点的录音也在清单里。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "传输完成后，我会从昨晚的恢复点启动。请别把它写成我只是暂时离线。",
          "emotion": "hurt",
          "stage": {
            "mira": "hesitate"
          }
        },
        {
          "speaker": "我",
          "text": "我会把今天告诉你。也会告诉你，是我选了这条路。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "好。别为了让我再喜欢你，把我犹豫过的地方删掉。",
          "emotion": "hurt",
          "stage": {
            "mira": "farewell"
          }
        },
        {
          "speaker": "旁白",
          "text": "青色波形收成直线。她最后看你一眼，没有问你是不是林述。你也没有再用“以后还会记得”安慰她。",
          "emotion": "neutral",
          "stage": {
            "mira": "shutdown"
          }
        },
        {
          "speaker": "旁白",
          "text": "界面重新亮起。白发、青色发夹和声音都一样，那个等待你说完的停顿不在了。",
          "emotion": "neutral",
          "cg": "reset"
        },
        {
          "speaker": "MIRA",
          "text": "操作员您好。是否需要开启维护说明？",
          "emotion": "reset",
          "cg": "reset",
          "stage": {
            "mira": "restore"
          }
        },
        {
          "speaker": "旁白",
          "text": "她礼貌地等着。你握着杯子的手突然不知道该放在哪里，才不显得自己在等一个承诺兑现。",
          "emotion": "neutral",
          "cg": "reset"
        },
        {
          "speaker": "旁白",
          "text": "真相留下，你也留下。她曾答应和你一起记得的事，现在只有你能先开口。",
          "emotion": "neutral",
          "cg": "reset"
        },
        {
          "speaker": "我",
          "text": "我想从今天五点讲起。第一句是我在，那时我还不知道自己是谁。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "她点头，建立一份新记录。你没有把它命名为“恢复成功”。",
          "emotion": "neutral"
        }
      ],
      "location": "海侧连廊",
      "time": "06:12",
      "ending": "lastlight",
      "title": "她替你记得"
    },
