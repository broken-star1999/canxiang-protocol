                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "speaker": "旁白",
          "text": "仍有缺失记录。你能如实报告发现的事，不能把缺口改成自己希望发生的那一种。",
          "emotion": "neutral"
        }
      ],
      "location": "站务控制室",
      "time": "06:05",
      "next": "fin_04",
      "title": "没有其他文件夹"
