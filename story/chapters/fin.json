    "end_witness": {
      "id": "end_witness",
      "bg": "sea",
      "beats": [
        {
          "speaker": "旁白",
          "text": "事故资料抵达站外。你终于没有让那个早晨只剩一份操作异常摘要。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你的身体却还没获准保留今天。文件上的接收时间，比恢复倒计时早了不到一分钟。",
          "emotion": "neutral"
        },
        {
          "speaker": "我",
          "text": "把接下来这句话也附进去。别缩成同意两个字。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "你说。我会原样录。",
          "emotion": "hurt"
        },
        {
          "speaker": "我",
          "text": "我愿意作证，不代表我同意被抹去。之后醒来的能读这份记录，但不是现在答应你的我。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "MIRA保存原话。窗外的金色越过桌角，杯子里的水已经不再烫手。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你想再握紧一点。那段温度还在，手指却先失去力气。",
          "emotion": "neutral"
        },
        {
          "speaker": "系统",
          "text": "当前会话结束。开始初始化。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "调查后来引用了你的证词，纠正了急停记录。载体处理一栏，仍有人写“缓存已清理”。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "林述在那四个字旁划了一道线，补上你的原话。她能替你争取一次更正，不能把没到来的第一次见面补回来。",
          "emotion": "neutral"
        }
      ],
      "location": "临海平台",
      "time": "06:10",
      "ending": "witness",
      "title": "无名的证人"
    },
    "end_together": {
      "id": "end_together",
      "bg": "control",
      "beats": [
        {
          "speaker": "旁白",
          "text": "原件收到独立回执。林述为昨晚的决定作证，你为今天的复核作证，共同记忆注明了同一个来源。",
          "emotion": "neutral"
        },
        {
          "speaker": "林述",
          "text": "我出院以后还要回来。你愿意先帮我盯着后续复核吗？不是替我回答。",
          "emotion": "concern"
        },
        {
          "speaker": "我",
          "text": "愿意。意见不一样的时候，我会写出来。",
          "emotion": "neutral"
        },
        {
          "speaker": "林述",
          "text": "那就各写一份。别再替我把难看的地方改得好听。",
          "emotion": "smile"
        },
        {
          "speaker": "旁白",
          "text": "周衡暂停联调，开始逐个通知排班表上的人。二十三个人将失望、追问或生气，他这次不能让一个数字替他们发言。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "延期许可到了。你和MIRA保住今天，后续调查也不会因你们留下就自动结束。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "下一次会议，我也要说自己的意见。包括反对你们的时候。",
          "emotion": "relief"
        },
        {
          "speaker": "旁白",
          "text": "名单里多出你的一行。身份来源和证词署名分开，没有“替原操作员继续履职”。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你将白外套留给林述，另外搬一张椅子。没有谁需要站着，证明另一张椅子原本就该属于自己。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "第一次会议还没开始。你坐下，等着一个可能和你想得不一样的回答。",
          "emotion": "neutral"
        }
      ],
      "location": "站务控制室",
      "time": "06:12",
      "ending": "dawn",
      "grant": [
        "export"
      ],
      "title": "留站 · 共同署名",
      "costumes": {
        "lin": "medical"
      },
      "communication": "远程通信 · 医疗舱"
    },
    "end_shelter": {
      "id": "end_shelter",
      "bg": "tea-empty",
      "beats": [
        {
          "speaker": "旁白",
          "text": "延期许可在内部结案后生效。你有了可以继续坐在茶水间里的身份，今天的记忆也被准许保留。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "事故仍写成操作员异常。原始目录进入恢复区，站外复核没有收到完整材料。",
          "emotion": "neutral"
        },
        {
          "speaker": "周衡",
          "text": "至少，他们明天还能来上班。",
          "emotion": "concern"
        },
        {
          "speaker": "旁白",
          "text": "排班表上的名字一个不少。你不知道他们会不会接受这个交换，因为签字以前没有人去问。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你曾经想留下自己的意见。现在，能保住这些意见的许可，要求它们别走出这间房。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "一周后，同型号联调恢复。第一次不同步警告，被归到“允许继续”的一栏。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "有人在茶水间说，只剩最后一轮。声音不完全像林述，也不完全像周衡。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "阿姨问早餐要不要加热。你说好，发现自己已经很熟悉怎样让这个早晨听起来一切正常。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "灯亮着。你终于获准留下，却开始明白，记得发生过什么和愿意继续回答，是两件事。",
          "emotion": "neutral"
        }
      ],
      "location": "值班茶水间",
      "time": "一周后",
      "ending": "shelter",
      "title": "二十三人的明天"
    },
    "fin_transmitted": {
      "id": "fin_transmitted",
      "bg": "control",
      "beats": [
        {
          "speaker": "旁白",
          "text": "你按下发送。进度停了一会儿，随后慢慢走完。",
          "emotion": "neutral"
        },
        {
          "speaker": "系统",
          "text": "接收成功。原件已保全。",
          "emotion": "neutral"
        },
