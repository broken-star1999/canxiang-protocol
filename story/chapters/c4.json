    "c4_rescue": {
      "id": "c4_rescue",
      "bg": "maintenance",
      "beats": [
        {
          "speaker": "旁白",
          "text": "你跑到维护门外。左臂的接缝轻轻震着，手动杆需要两只手才能拉到底。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "先转锁销，再拉。不要碰旁边的复位按钮。",
          "emotion": "serious"
        },
        {
          "speaker": "旁白",
          "text": "你用右手抵住锁销，左手拉住杆。第一次没动，第二次它终于松了。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "周衡从门缝里侧身出来，靠着墙喘气。他手里攥着一块离线盘。",
          "emotion": "neutral",
          "cg": "rescue"
        },
        {
          "speaker": "周衡",
          "text": "我拿到了。",
          "emotion": "concern",
          "cg": "rescue"
        },
        {
          "speaker": "我",
          "text": "下次别一个人进去。",
          "emotion": "neutral",
          "cg": "rescue"
        },
        {
          "speaker": "周衡",
          "text": "……对不起。",
          "emotion": "admit",
          "cg": "rescue"
        },
        {
          "speaker": "我",
          "text": "先坐下。",
          "emotion": "neutral",
          "cg": "rescue"
        },
        {
          "speaker": "旁白",
          "text": "你把他扶到连廊的长椅上。门在你们身后落锁，辅助臂仍在空房间里完成它错误的复位。",
          "emotion": "neutral",
          "background": "bridge-dawn",
          "location": "海侧连廊 · 长椅"
        },
        {
          "speaker": "旁白",
          "text": "你突然理解了“人不在现场”应该先被确认，而不是写进一张表就算发生。",
          "emotion": "neutral",
          "background": "bridge-dawn",
          "location": "海侧连廊 · 长椅"
        }
      ],
      "location": "维护通道 · 机械门外",
      "time": "06:00",
      "next": "c4_after",
      "title": "门开以后"
    },
    "c4_record": {
      "id": "c4_record",
      "bg": "archive-alert",
      "beats": [
        {
          "speaker": "旁白",
          "text": "你开始导出门控日志。MIRA的声音从另一条通信里持续传来。",
          "emotion": "neutral",
          "communication": "远程通信 · 维护区"
        },
        {
          "speaker": "MIRA",
          "text": "不要移动。看着地面那条黄线。下一次经过时也不要退到设备侧。",
          "emotion": "serious",
          "communication": "远程通信 · 维护区"
        },
        {
          "speaker": "周衡",
          "text": "我知道。你让它别再走了。",
          "emotion": "neutral",
          "communication": "远程通信 · 维护区"
        },
        {
          "speaker": "MIRA",
          "text": "我不能直接停机。我在开门，先站住别动。",
          "emotion": "serious",
          "communication": "远程通信 · 维护区"
        },
        {
          "speaker": "旁白",
          "text": "进度条走到末尾，你拔下数据盘，冲向门外。",
          "emotion": "neutral",
          "communication": "远程通信 · 维护区"
        },
        {
          "speaker": "旁白",
          "text": "周衡出来时，袖口被划开，手里还握着离线盘。他没有责问你，先问自己站的位置是否记下了。",
          "emotion": "neutral",
          "background": "maintenance",
          "location": "维护通道 · 机械门外"
        },
        {
          "speaker": "我",
          "text": "记下了。你还好吗？",
          "emotion": "neutral",
          "background": "maintenance",
          "location": "维护通道 · 机械门外"
        },
        {
          "speaker": "周衡",
          "text": "能走。我以后再也不想听见“只是复位”。",
          "emotion": "concern",
          "background": "maintenance",
          "location": "维护通道 · 机械门外"
        },
        {
          "speaker": "旁白",
          "text": "你扶他到长椅上，把受损的袖口折开检查。你得到了记录，也看见等待的风险确实落在一个人的身上。",
          "emotion": "neutral",
          "background": "bridge-dawn",
          "location": "海侧连廊 · 长椅"
        }
      ],
      "location": "维护档案室",
      "time": "06:00",
      "next": "c4_after",
      "setFlags": {
        "zhouWounded": true
      },
      "title": "被等待的人"
    },
    "c4_06": {
      "id": "c4_06",
      "bg": "sea",
      "beats": [
        {
