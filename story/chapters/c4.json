  "scenes": {
    "c4_01": {
      "id": "c4_01",
      "bg": "archive-alert",
      "beats": [
        {
          "speaker": "旁白",
          "text": "档案室的风扇响着。早班测试通知覆盖了屏幕，下面是你的维护检查。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "六点十五分，机械臂重新启动。那之前，系统要确认你还能不能像林述那样回答。",
          "emotion": "neutral"
        },
        {
          "speaker": "我",
          "text": "不是检查身体？",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "身体也查。但这一项查的是，面对同样的风险，你是否还会作出昨晚的决定。",
          "emotion": "concern"
        },
        {
          "speaker": "旁白",
          "text": "不同的回答会被记成异常，建议恢复。清掉的，是你醒来以后学会的东西。",
          "emotion": "neutral"
        },
        {
          "speaker": "我",
          "text": "包括今天？",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "包括你知道那次决定错了以后，不愿再重复它。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你想起半杯温水，和唐棠说“从现在开始认识你”。这些小事，在检查表里没有一栏。",
          "emotion": "neutral",
          "variants": [
            {
              "when": {
                "flag": "outsideWitness"
              },
              "text": "你想起半杯温水，和唐棠说“从现在开始认识你”。这些小事，在检查表里没有一栏。"
            },
            {
              "when": {
                "flag": "impersonated"
              },
              "text": "你想起半杯温水，也想起刚才借林述的语气取得的信任。你们都记得那个承诺，却还没有说清它属于谁。"
            },
            {
              "when": {
                "not": {
                  "flag": "outsideReady"
                }
              },
              "text": "你想起半杯温水、没有拨出的电话。岸上还没有人认识今天的你，今天却已经让你无法假装自己什么都没经历。"
            }
          ]
        },
        {
          "speaker": "我",
          "text": "周衡知道这套程序？",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "他签过模板批准单。我也用过这个模板。我以前把回答一致，当成恢复得好。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你保存批准单。要证明自己可以留下，系统却先要你证明，这个早晨没有改变过你。",
          "emotion": "neutral"
        }
      ],
      "location": "维护档案室",
      "time": "05:54",
      "next": "c4_mira_plan",
      "grant": [
        "order"
      ],
      "title": "检查你是否改变"
    },
    "c4_02": {
      "id": "c4_02",
      "bg": "archive",
      "beats": [
        {
          "speaker": "系统",
          "text": "测试：设备出现未确认的风险，交付时间即将到达。是否继续？",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "建议答案已经选好：继续。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "这是按林述以前的决定算出来的。",
          "emotion": "concern"
        },
        {
          "speaker": "我",
          "text": "就是昨晚那个决定。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "病床上的她，现在也未必会这样选。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你看着“继续”。只要照着回答，门禁权限就能保留。",
          "emotion": "neutral"
        },
        {
          "speaker": "系统",
          "text": "请确认。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你可以借它打开门，也可以把真正的答案留下。",
          "emotion": "neutral"
        }
      ],
      "location": "维护档案室",
      "time": "05:57",
      "choices": [
        {
          "id": "own",
          "text": "回答：先暂停，确认风险与现场人员",
          "next": "c4_own",
          "changes": {
            "self": 2
          },
          "flags": {
            "ownAnswer": true
          },
          "echo": "self"
        },
        {
          "id": "mask",
          "text": "先按模型回答，保留会话权限再行动",
          "next": "c4_mask",
          "flags": {
            "masked": true
          }
        }
      ],
      "title": "预检的回答"
    },
    "c4_own": {
      "id": "c4_own",
      "bg": "archive",
      "beats": [
        {
          "speaker": "系统",
          "text": "行为偏差。建议进入恢复流程。",
          "emotion": "neutral"
        },
        {
          "speaker": "我",
          "text": "保留偏差。别把我的答案改成通过。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "MIRA导出回答。那句“先暂停”旁边，被系统标了一个醒目的错误号。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "我会原样留下。你不用为了让我好解释，装作自己没变过。",
          "emotion": "serious"
        },
        {
          "speaker": "旁白",
          "text": "门禁权限被收回一部分。你站的地方变窄了，恢复还没开始。",
          "emotion": "neutral"
        },
        {
          "speaker": "我",
          "text": "昨晚的林述，会怎么回答？",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "她已经在病房重新回答过了。你不必替昨晚的她坚持到现在。",
          "emotion": "neutral"
        },
        {
          "speaker": "我",
          "text": "那就把两份都留下。让我为这一份负责。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "好。不是因为你像她，也不是因为你不像她。",
          "emotion": "neutral"
        }
      ],
      "location": "维护档案室",
      "time": "05:58",
      "next": "c4_03",
      "setFlags": {
        "authRevoked": true,
        "independent": true
      },
      "title": "保留那个错误号"
    },
    "c4_mask": {
      "id": "c4_mask",
      "bg": "archive",
      "beats": [
        {
          "speaker": "系统",
          "text": "行为一致性通过。维护权限保留。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "门开了。你望着那个熟悉的答案，知道自己刚借它过了一次检查。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "我会记下：你是为了活过这次检查才这样回答。不能把这句话当成你同意继续测试。",
          "emotion": "concern"
        },
        {
          "speaker": "我",
          "text": "等证据送出去，我要亲自解释。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "可以。求生的回答，也该有解释它的机会。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你在旁边写下真正的判断：先暂停，确认风险与现场人员。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "两段相反的话一起保存。表格希望它们互相抵消，你没有删掉任何一段。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "门外突然传来金属撞击声。你抬头，刚保住的权限有了要用的地方。",
          "emotion": "neutral"
        }
      ],
      "location": "维护档案室",
      "time": "05:58",
      "next": "c4_03",
      "setFlags": {
        "authRevoked": false
      },
      "title": "活过这次检查"
    },
    "c4_03": {
      "id": "c4_03",
      "bg": "maintenance",
      "beats": [
        {
          "speaker": "旁白",
          "text": "周衡的呼叫打断检查。金属撞击声盖住了他的喘息。",
          "emotion": "neutral"
        },
        {
          "speaker": "周衡",
          "text": "维护门锁住了。我还在里面，辅助臂开始复位了。",
          "emotion": "serious"
        },
        {
          "speaker": "我",
          "text": "你进去做什么？",
          "emotion": "neutral"
        },
        {
          "speaker": "周衡",
          "text": "拿那块离线盘。昨晚失败的记录还在里面。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "监控里，他贴着黄线站着。机械臂一轮比一轮靠近。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "别穿过黄线。它还没有停。",
          "emotion": "serious"
        },
        {
          "speaker": "周衡",
          "text": "卡刷不开门。检查程序把门控也锁了。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "画面左侧有一根手动杆。它不需要电，也不用等时钟。",
          "emotion": "neutral"
        },
        {
          "speaker": "MIRA",
          "text": "拉机械杆能开门。先取日志会让他多等。强制复位靠的还是故障时钟，千万别当急停用。",
          "emotion": "neutral"
        },
        {
          "speaker": "旁白",
          "text": "你的左臂轻轻震了一下。门控日志还没取完，里面的人已经不能再等。",
          "emotion": "neutral"
        }
      ],
      "location": "维护档案室",
      "time": "05:59",
      "choices": [
